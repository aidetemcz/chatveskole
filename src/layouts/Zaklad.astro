---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '../styles/global.css';
import Hlavicka from '../components/Hlavicka.astro';
import Paticka from '../components/Paticka.astro';

interface Props { title: string; popis?: string }
const { title, popis } = Astro.props;
const titulek = title === 'Chatboti ve škole' ? title : `${title} | Chatboti ve škole`;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulek}</title>
    {popis && <meta name="description" content={popis} />}
    <link rel="canonical" href={new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site)} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light only" />
  </head>
  <body>
    <a class="skip" href="#obsah">Přeskočit na obsah</a>
    <Hlavicka />
    <main id="obsah" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Paticka />
    <p class="sr-only" aria-live="polite" data-hlaseni></p>
    <script>
      // Tlačítka Kopírovat: [data-kopirovat] zkopíruje prompt z bloku vedle, [data-kopirovat-z="id"] z <template id>.
      const hlaseni = document.querySelector<HTMLElement>('[data-hlaseni]');
      document.addEventListener('click', async (e) => {
        const t = (e.target as Element).closest<HTMLButtonElement>('[data-kopirovat], [data-kopirovat-z]');
        if (!t) return;
        const text = t.dataset.kopirovatZ
          ? (document.getElementById(t.dataset.kopirovatZ) as HTMLTemplateElement | null)?.content.textContent ?? ''
          : t.parentElement?.querySelector('pre')?.textContent ?? '';
        const puvodni = t.dataset.puvodni ?? t.textContent ?? '';
        t.dataset.puvodni = puvodni;
        try {
          await navigator.clipboard.writeText(text.trim());
          t.textContent = 'Zkopírováno ✓';
          if (hlaseni) hlaseni.textContent = 'Prompt je zkopírovaný do schránky.';
        } catch {
          t.textContent = 'Nepodařilo se, označte text ručně';
        }
        setTimeout(() => { t.textContent = puvodni; }, 2500);
      });
    </script>
  </body>
</html>
