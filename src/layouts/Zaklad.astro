---
// Základní layout. Design (tokeny, fonty, hlavička, patička) doplní fáze 2.
import { navigace } from '../lib/web';

interface Props { title: string; popis?: string; koncept?: boolean }
const { title, popis, koncept = false } = Astro.props;
const titulek = title === 'Chatboti ve škole' ? title : `${title} | Chatboti ve škole`;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulek}</title>
    {popis && <meta name="description" content={popis} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header>
      <a href="/">Chatboti ve škole</a>
      <nav aria-label="Hlavní menu">
        <ul>
          {navigace.menu.map((sekce) => (
            <li>
              {sekce.title}
              <ul>{sekce.items.map((i) => <li><a href={i.href}>{i.title}</a></li>)}</ul>
            </li>
          ))}
          <li><a href={navigace.cta.href}>{navigace.cta.title}</a></li>
        </ul>
      </nav>
    </header>
    <main>
      {koncept && <p class="stitek-koncept">Koncept</p>}
      <slot />
    </main>
    <footer><p>Chatboti ve škole · AI dětem</p></footer>
  </body>
</html>
