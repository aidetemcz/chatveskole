---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NovyWebModal from '../components/NovyWebModal.astro';
import CookieLista from '../components/CookieLista.astro';
import { url } from '../lib/url';
import { indexovat } from '../lib/indexovat.mjs';

interface Props { title: string; description?: string; noindex?: boolean }
const { title, description, noindex } = Astro.props;
const fullTitle = title === 'Chatboti ve škole' ? title : `${title} | Chatboti ve škole`;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
// indexovat jen ostrý web na chatveskole.cz (viz src/lib/indexovat.mjs); náhledy na github.io a vercel.app ne
const nahled = !indexovat;
// Vercel Web Analytics (bez cookies, schválila Eva 21. 11. 2026): jen v produkčním buildu na Vercelu, jinde skript neexistuje
const mereni = process.env.VERCEL_ENV === 'production';
const ogImage = new URL(url('/img/og-chatveskole.jpg'), Astro.site);
const domov = new URL(url('/'), Astro.site).href;
// Strukturovaná data pro vyhledávače: provozovatel a web s vyhledáváním (schema.org)
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://aidetem.cz/#organizace',
      name: 'AI dětem, z. s.',
      url: 'https://aidetem.cz',
      logo: new URL(url('/img/logo-ai-detem.png'), Astro.site).href,
      sameAs: [
        'https://www.facebook.com/groups/aidetem',
        'https://www.linkedin.com/company/aidetem/',
        'https://www.instagram.com/ai_detem/',
        'https://www.youtube.com/@aidetemcz',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': domov + '#web',
      name: 'Chatboti ve škole',
      description: 'Dovednosti, prompty a návody pro vyučující a vedení škol',
      url: domov,
      inLanguage: 'cs',
      publisher: { '@id': 'https://aidetem.cz/#organizace' },
      potentialAction: {
        '@type': 'SearchAction',
        target: new URL(url('/hledat/'), Astro.site).href + '?q={search_term_string}',
        'query-input': 'required name=search_term_string',
      },
    },
  ],
});
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" data-stranka />}
    {nahled && !noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/img/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="48x48" href={url('/img/favicon-48.png')} />
    <link rel="apple-touch-icon" href={url('/img/apple-touch-icon.png')} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Chatboti ve škole" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Chatboti ve škole – ucelený rozcestník pro vyučující i vedení škol, kteří chtějí generativní AI využít ve své práci" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={jsonLd} />
    {mereni && <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>}
    {mereni && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </head>
  <body>
    <a class="skip" href="#obsah">Přeskočit na obsah</a>
    <Header />
    <main id="obsah" data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <Footer />
    <NovyWebModal />
    <CookieLista zapnuto={mereni} />
    <script>
      // Kopírování: tlačítko s data-copy="id elementu s textem" nebo data-copy-text
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy], [data-copy-text]');
        if (!btn) return;
        const id = btn.dataset.copy;
        const el = id ? document.getElementById(id) : null;
        const text = el instanceof HTMLTemplateElement ? (el.content.textContent ?? '') : el ? (el.textContent ?? '') : (btn.dataset.copyText ?? '');
        try {
          await navigator.clipboard.writeText(text.trim());
          const label = btn.querySelector('[data-label]');
          if (label) {
            const orig = label.textContent;
            label.textContent = 'Zkopírováno';
            setTimeout(() => { label.textContent = orig; }, 2000);
          }
        } catch { /* schránka nedostupná */ }
      });
      // Tlačítko Kopírovat u bloků ```text v Markdownu
      document.querySelectorAll<HTMLElement>('.prose pre > code.language-text').forEach((code, i) => {
        const pre = code.parentElement!;
        code.id = code.id || `prompt-${i}`;
        const wrap = document.createElement('div');
        wrap.className = 'prompt-block';
        wrap.innerHTML = `<div class="copy-row"><button type="button" class="copy-btn" data-copy="${code.id}"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg><span data-label>Kopírovat</span></button></div>`;
        pre.replaceWith(wrap);
        wrap.appendChild(pre);
      });
      // Přepínače: [data-switch] obsahuje tlačítka s data-target; zobrazí jen odpovídající [data-group-view]
      document.querySelectorAll<HTMLElement>('[data-switch]').forEach((sw) => {
        const scope = document.getElementById(sw.dataset.switch!) ?? document;
        const buttons = sw.querySelectorAll<HTMLButtonElement>('button[data-target]');
        buttons.forEach((b) => b.addEventListener('click', () => {
          buttons.forEach((x) => {
            const on = x === b;
            x.setAttribute(x.getAttribute('role') === 'tab' ? 'aria-selected' : 'aria-pressed', String(on));
          });
          scope.querySelectorAll<HTMLElement>(':scope > [data-group-view]').forEach((v) => { v.hidden = v.dataset.groupView !== b.dataset.target; });
        }));
      });
    </script>
  </body>
</html>
