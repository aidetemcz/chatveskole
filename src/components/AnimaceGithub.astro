---
// Animace „Jak agent pracuje s GitHubem“ pro stránku Vibe Coding pro pokročilé (21. 11. 2026).
// Čtyři fáze ve smyčce 12 s: propojení agenta s repozitářem → nová větev se změnami → pull request a schválení → sloučení a zveřejnění webu.
// Jen CSS, bez JavaScriptu. Při prefers-reduced-motion se ukáže konečný stav.
---
<figure class="anim" role="img" aria-label="Animace: agent se propojí s repozitářem na GitHubu, změny uloží do nové větve, připraví pull request, po schválení se změny sloučí do hlavní větve a hosting web znovu zveřejní.">
  <svg viewBox="0 0 520 330" aria-hidden="true">
    <!-- agent -->
    <g class="uzel">
      <rect x="14" y="40" width="150" height="96" rx="10" class="box box--agent" />
      <g transform="translate(32 58)" class="ikona">
        <path d="M2 2h22a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H12l-6 5v-5H2a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3z" />
      </g>
      <text x="32" y="104" class="nazev">Agent</text>
      <text x="32" y="122" class="pod">Claude Code, Codex</text>
    </g>

    <!-- propojení agent ↔ GitHub -->
    <path d="M164 88 H236" class="spoj spoj--propojeni" />
    <text x="200" y="78" class="stitek-cary f1">propojení</text>

    <!-- GitHub repozitář -->
    <rect x="236" y="14" width="270" height="186" rx="10" class="box" />
    <text x="254" y="40" class="nazev">GitHub</text>
    <text x="320" y="40" class="pod">repozitář</text>

    <!-- hlavní větev -->
    <path d="M256 150 H486" class="hlavni" />
    <circle cx="272" cy="150" r="6" class="commit" />
    <circle cx="478" cy="150" r="6" class="commit commit--novy f4" />
    <text x="256" y="178" class="pod">hlavní větev</text>

    <!-- nová větev se změnami -->
    <path d="M290 150 C 312 150, 310 88, 332 88 H 428 C 450 88, 448 150, 470 150" class="vetev f2" pathLength="1" />
    <circle cx="358" cy="88" r="6" class="commit commit--vetev f2b" />
    <circle cx="402" cy="88" r="6" class="commit commit--vetev f2c" />
    <text x="380" y="74" class="stitek-cary f2b">nová větev</text>

    <!-- pull request -->
    <g class="pr f3">
      <rect x="333" y="161" width="90" height="26" rx="13" class="pr-box" />
      <text x="378" y="178" class="pr-text">pull request</text>
    </g>
    <g class="schvaleno f3b">
      <circle cx="438" cy="174" r="11" class="ok" />
      <path d="M433 174l4 4 7-8" class="ok-znak" />
    </g>

    <!-- zveřejnění -->
    <path d="M478 200 V 246" class="spoj spoj--web f4" />
    <rect x="236" y="246" width="270" height="70" rx="10" class="box box--web f4web" />
    <text x="254" y="276" class="nazev">Web</text>
    <text x="254" y="298" class="pod">hosting zveřejní novou verzi</text>
  </svg>
  <figcaption>
    <ol class="faze">
      <li class="p1"><span>1</span>Propojení</li>
      <li class="p2"><span>2</span>Změny ve větvi</li>
      <li class="p3"><span>3</span>Pull request</li>
      <li class="p4"><span>4</span>Zveřejnění</li>
    </ol>
  </figcaption>
</figure>

<style>
  .anim { margin: 0; background: var(--panel); border: 1px solid var(--sky); border-radius: var(--radius-lg); padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  svg { width: 100%; height: auto; display: block; font-family: var(--fb); }
  .box { fill: var(--bg); stroke: var(--sky); stroke-width: 1.5; }
  .box--agent { fill: var(--sky-light); }
  .box--web { fill: var(--accent-soft); stroke: var(--accent); }
  .ikona path { fill: none; stroke: var(--sky-deep); stroke-width: 2.4; stroke-linejoin: round; }
  .nazev { font-family: var(--fh); font-weight: 700; font-size: 17px; fill: var(--ink); }
  .pod { font-size: 12px; fill: var(--muted); }
  .stitek-cary { font-size: 11px; font-weight: 600; fill: var(--sky-ink); text-anchor: middle; }
  .spoj { fill: none; stroke: var(--sky-deep); stroke-width: 2.5; stroke-dasharray: 6 6; }
  .hlavni { fill: none; stroke: var(--sky-deep); stroke-width: 3; stroke-linecap: round; }
  .vetev { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 1; }
  .commit { fill: var(--bg); stroke: var(--sky-deep); stroke-width: 2.5; }
  .commit--vetev { stroke: var(--accent); }
  .commit--novy { fill: var(--accent); stroke: var(--accent); }
  .pr-box { fill: var(--bg); stroke: var(--accent); stroke-width: 1.5; }
  .pr-text { font-size: 12px; font-weight: 600; fill: var(--ink); text-anchor: middle; }
  .ok { fill: var(--accent); }
  .ok-znak { fill: none; stroke: var(--on-accent); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

  .faze { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.85rem; }
  .faze li { display: flex; align-items: center; gap: 8px; padding: 5px 12px 5px 6px; border-radius: var(--pill); background: var(--sky-light); white-space: nowrap; }
  .faze span { flex: none; width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 600; font-size: 0.75rem; background: var(--panel); }

  /* animace: smyčka 12 s, každá fáze 3 s */
  @media (prefers-reduced-motion: no-preference) {
    .spoj--propojeni { animation: propojeni 12s linear infinite; }
    .f1 { animation: f1 12s infinite; }
    .f2 { animation: vetev 12s infinite; }
    .f2b { animation: f2b 12s infinite; }
    .f2c { animation: f2c 12s infinite; }
    .f3 { animation: f3 12s infinite; }
    .f3b { animation: f3b 12s infinite; }
    .f4 { animation: f4 12s infinite; }
    .f4web { animation: web 12s infinite; }
    .faze li { animation: faze 12s infinite; }
    .faze .p2 { animation-delay: 3s; }
    .faze .p3 { animation-delay: 6s; }
    .faze .p4 { animation-delay: 9s; }
  }
  @keyframes propojeni { 0% { stroke-dashoffset: 48; opacity: 0.2; } 12% { opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 1; } }
  @keyframes f1 { 0%, 3% { opacity: 0; } 10%, 100% { opacity: 1; } }
  @keyframes vetev { 0%, 25% { stroke-dashoffset: 1; } 38%, 100% { stroke-dashoffset: 0; } }
  @keyframes f2b { 0%, 30% { opacity: 0; } 34%, 100% { opacity: 1; } }
  @keyframes f2c { 0%, 38% { opacity: 0; } 42%, 100% { opacity: 1; } }
  @keyframes f3 { 0%, 50% { opacity: 0; transform: translateY(6px); } 56%, 100% { opacity: 1; transform: none; } }
  @keyframes f3b { 0%, 64% { opacity: 0; } 68%, 100% { opacity: 1; } }
  @keyframes f4 { 0%, 75% { opacity: 0; } 80%, 100% { opacity: 1; } }
  @keyframes web { 0%, 80% { fill: var(--bg); stroke: var(--sky); } 86%, 100% { fill: var(--accent-soft); stroke: var(--accent); } }
  @keyframes faze { 0%, 24% { background: var(--accent-soft); box-shadow: inset 0 0 0 1.5px var(--accent); } 25%, 100% { background: var(--sky-light); box-shadow: none; } }
</style>
