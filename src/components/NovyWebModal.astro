---
// Uvítací okno při první návštěvě: web se obsahově i vizuálně proměnil (Eva 21. 11. 2026).
// Zobrazí se jednou; po zavření se do localStorage uloží příznak (žádné cookies). Bez JavaScriptu se nezobrazí.
import { url } from '../lib/url';
---
<dialog class="novy-web" id="novy-web" aria-labelledby="novy-web-h" data-pagefind-ignore style={`background-image: url(${url('/img/novy-web-modal.jpg')})`}>
  <div class="novy-web-obsah">
    <h2 id="novy-web-h">Web má novou podobu</h2>
    <p>Chatboti ve škole jsme obsahově i vizuálně proměnili. Některé stránky najdete jinde než dřív.</p>
    <div class="novy-web-tlacitka">
      <button type="button" class="btn btn--primary" data-zavrit>Prohlédnout web</button>
      <a class="btn btn--outline novy-web-odkaz" href={url('/o-webu/novy-web')} data-zavrit>Co je nového</a>
    </div>
  </div>
</dialog>

<script>
  const KLIC = 'chatveskole-novy-web-2026';
  const dialog = document.getElementById('novy-web') as HTMLDialogElement | null;
  let videno = false;
  try { videno = localStorage.getItem(KLIC) === '1'; } catch { /* úložiště nedostupné */ }
  const uloz = () => { try { localStorage.setItem(KLIC, '1'); } catch { /* úložiště nedostupné */ } };
  if (dialog && !videno && typeof dialog.showModal === 'function') {
    dialog.showModal();
    dialog.addEventListener('close', uloz);
    dialog.querySelectorAll('[data-zavrit]').forEach((el) => el.addEventListener('click', () => { uloz(); dialog.close(); }));
    // klik mimo okno zavře
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  }
</script>

<style>
  .novy-web {
    width: min(92vw, 720px);
    aspect-ratio: 1000 / 769;
    padding: 0;
    border: 4px solid #fff;
    border-radius: 24px;
    background-color: #fac6c8; background-position: center; background-size: cover; background-repeat: no-repeat;
    box-shadow: 0 24px 60px rgba(28, 37, 48, 0.35);
    overflow: hidden;
  }
  .novy-web::backdrop { background: rgba(28, 37, 48, 0.55); }
  .novy-web-obsah { padding: 40px 40px 0; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; max-width: 560px; margin: 0 auto; }
  .novy-web h2 { margin: 0; font-size: clamp(1.4rem, 3.6vw, 1.9rem); line-height: 1.2; color: var(--ink); }
  .novy-web p { margin: 0; font-size: clamp(0.88rem, 2.2vw, 1rem); line-height: 1.5; color: var(--ink); }
  .novy-web-tlacitka { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 10px; }
  .novy-web-tlacitka .btn { padding-block: 10px; }
  .novy-web-odkaz { background: #fff; }
  @media (max-width: 520px) {
    .novy-web { aspect-ratio: auto; background-position: center bottom; background-size: 100% auto; padding-bottom: 58%; }
    .novy-web-obsah { padding: 22px 20px 0; }
  }
</style>
