---
// Instrukce pro chatboty: krátký prompt → podrobný prompt → skill (→ pluginy), tři animace v canvasu.
// Předloha: artifact https://claude.ai/artifact/G5qt2LLqKxcYXvAJ8Kokd4 (12. 11. 2026).
// Skript animace je převzatý beze změny; písma jsou self-hostovaná (Inter, Space Grotesk, JetBrains Mono).
import '@fontsource/jetbrains-mono/700.css';
import { url } from '../lib/url';
---
<section class="band band--hp band--white instr-hlavicka" aria-labelledby="instr-h">
  <div class="wrap">
    <h2 id="instr-h">Instrukce <em>pro chatboty</em></h2>
    <p class="lede">Instrukce chatbotu říkají, co přesně má udělat. Čím přesnější instrukce, tím přesnější výsledek. Podívejte se, jak to vypadá, když chatbota pošlete pro červenou rybu.</p>
  </div>
</section>

<section class="band band--hp band--sky instr-faze" aria-labelledby="instr-f1">
  <div class="wrap faze">
    <div class="anim">
      <canvas data-druh="1" aria-hidden="true"></canvas>
      <button class="pauza" type="button" aria-pressed="false" aria-label="Pozastavit animaci" data-stav="bezi"><svg class="i-pauza" viewBox="0 0 12 12" aria-hidden="true"><rect x="2.5" y="2" width="2.4" height="8" rx="0.6"></rect><rect x="7.1" y="2" width="2.4" height="8" rx="0.6"></rect></svg><svg class="i-hrat" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 2.2v7.6a.5.5 0 0 0 .76.43l6.1-3.8a.5.5 0 0 0 0-.86l-6.1-3.8a.5.5 0 0 0-.76.43z"></path></svg></button>
    </div>
    <div class="text">
      <span class="krok" aria-hidden="true">1</span>
      <h3 id="instr-f1">Krátký prompt</h3>
      <p>Napíšete jen pár slov. Chatbot přesně neví, co chcete, a tak zkouší. Napoprvé se často netrefí.</p>
    </div>
  </div>
</section>

<section class="band band--hp band--white instr-faze" aria-labelledby="instr-f2">
  <div class="wrap faze">
    <div class="anim">
      <canvas data-druh="2" aria-hidden="true"></canvas>
      <button class="pauza" type="button" aria-pressed="false" aria-label="Pozastavit animaci" data-stav="bezi"><svg class="i-pauza" viewBox="0 0 12 12" aria-hidden="true"><rect x="2.5" y="2" width="2.4" height="8" rx="0.6"></rect><rect x="7.1" y="2" width="2.4" height="8" rx="0.6"></rect></svg><svg class="i-hrat" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 2.2v7.6a.5.5 0 0 0 .76.43l6.1-3.8a.5.5 0 0 0 0-.86l-6.1-3.8a.5.5 0 0 0-.76.43z"></path></svg></button>
    </div>
    <div class="text">
      <span class="krok" aria-hidden="true">2</span>
      <h3 id="instr-f2">Podrobný prompt</h3>
      <p>Napíšete přesně, co chcete a jak na to. Chatbot se trefí napoprvé. Takhle dlouhý prompt ale musíte pokaždé napsat celý znovu.</p>
          <a class="more" href={url('/prompty')}>Katalog promptů →</a>
    </div>
  </div>
</section>

<section class="band band--hp band--sky instr-faze" aria-labelledby="instr-f3">
  <div class="wrap faze">
    <div class="anim">
      <canvas data-druh="3" aria-hidden="true"></canvas>
      <button class="pauza" type="button" aria-pressed="false" aria-label="Pozastavit animaci" data-stav="bezi"><svg class="i-pauza" viewBox="0 0 12 12" aria-hidden="true"><rect x="2.5" y="2" width="2.4" height="8" rx="0.6"></rect><rect x="7.1" y="2" width="2.4" height="8" rx="0.6"></rect></svg><svg class="i-hrat" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 2.2v7.6a.5.5 0 0 0 .76.43l6.1-3.8a.5.5 0 0 0 0-.86l-6.1-3.8a.5.5 0 0 0-.76.43z"></path></svg></button>
    </div>
    <div class="text">
      <span class="krok" aria-hidden="true">3</span>
      <h3 id="instr-f3">Skill</h3>
      <p>Podrobné instrukce máte v chatbotu uložené jako skill. Napíšete jen pár slov a chatbot přesně ví, co a jak udělat.</p>
          <a class="more" href={url('/skills')}>Katalog skills →</a>
    </div>
  </div>
</section>

<section class="band band--hp band--white instr-shrnuti" aria-label="Shrnutí">
  <div class="wrap">
    <p class="pointa">Prompt i skill jsou instrukce. Skill jen <em>nemusíte pokaždé psát znovu.</em></p>
    <p class="pluginy">Víc skills pohromadě tvoří <strong>plugin</strong>: celou sadu nainstalujete najednou.</p>
    <p class="odkazy"><a class="more" href={url('/prompty')}>Katalog promptů →</a><a class="more" href={url('/skills')}>Katalog skills →</a><a class="more" href={url('/funkce/pluginy')}>Co jsou pluginy →</a></p>
  </div>
</section>

<style>
  .instr-hlavicka { padding-bottom: 48px; }
  .instr-hlavicka h2 { font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 700; margin: 0 0 14px; }
  .instr-hlavicka h2 em { font-style: normal; color: var(--accent); }
  .instr-hlavicka .lede { max-width: 70ch; font-size: 1.05rem; color: #1f3f4d; }
  .faze { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 44px; align-items: center; }
  .anim { position: relative; aspect-ratio: 4 / 3; border: 1px solid var(--sky); border-radius: var(--radius-lg); overflow: hidden; background: var(--sky-light); }
  .anim canvas { display: block; width: 100%; height: 100%; }
  .pauza { position: absolute; right: 14px; bottom: 14px; width: 26px; height: 26px; padding: 0; border: 0; border-radius: 50%; display: grid; place-items: center; background: rgba(255, 255, 255, 0.72); color: #1f3f4d; cursor: pointer; }
  .pauza:hover { background: #fff; }
  .pauza:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pauza svg { width: 11px; height: 11px; fill: currentColor; }
  .pauza[data-stav='bezi'] .i-hrat, .pauza[data-stav='stoji'] .i-pauza { display: none; }
  .krok { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--accent); color: #fff; font: 600 1rem/1 var(--fh); margin-bottom: 14px; }
  .text h3 { font-size: 1.7rem; font-weight: 600; margin: 0 0 12px; }
  .text p { margin: 0; max-width: 42ch; font-size: 1.05rem; }
  .text .more { display: inline-block; margin-top: 18px; }
  .instr-shrnuti { text-align: center; }
  .pointa { margin: 0 auto; max-width: 46ch; font: 600 1.5rem/1.35 var(--fh); color: var(--ink); text-wrap: balance; }
  .pointa em { font-style: normal; color: var(--accent); }
  .pluginy { margin: 18px auto 0; max-width: 56ch; font-size: 1.05rem; color: var(--muted); }
  .odkazy { margin-top: 24px; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 28px; }
  @media (max-width: 860px) {
    .faze { grid-template-columns: 1fr; gap: 24px; }
  }
</style>

<script>
(() => {
  'use strict';
  // ---------- barvy a rozměry (stejné jako HeroKrajina.astro) ----------
  const B = { bg: '#e3f1f6', sky: '#b3cdd6', skyDeep: '#5f8c9b', skyInk: '#3f6b7a', navy: '#2f5868', navyDeep: '#1f3f4d',
    red: '#dc5b5b', redDark: '#c24848', redLight: '#e88585', blue2: '#7fa6b4', white: '#ffffff' };
  const VODA = ['#d3e6ed', '#c9dfe8', '#bfd7e1', '#b4cfdb', '#a8c6d3'];
  const MONO = '"JetBrains Mono", ui-monospace, Menlo, Consolas, monospace';
  const SANS = 'Inter, system-ui, -apple-system, "Segoe UI", sans-serif';
  const LW = 800, LH = 600;        // logické plátno 4:3
  const S = 5;                     // velikost pixelu postav
  const HL = 330;                  // hladina
  const BX = 280;                  // střed loďky
  const BOX = { x: 34, y: 20, w: 732, h: 112 };
  const PROMPT_KRATKY = 'Červená ryba';
  const PROMPT_DLOUHY = 'Červená ryba. Hoď síť tam, kde jich plave nejvíc, vytáhni ji nad hladinu, červené ryby dej do loďky a modré pusť zpátky do moře.';
  const SKILL = 'Skill: Lov červených ryb';

  // ---------- pomocné funkce ----------
  const h3 = (x, y, s) => { let h = (Math.imul(x | 0, 374761393) + Math.imul(y | 0, 668265263) + Math.imul(s | 0, 2147483647)) | 0; h = Math.imul(h ^ (h >>> 13), 1274126177); return ((h ^ (h >>> 16)) >>> 0) / 4294967296; };
  function rng(seed) { let a = seed >>> 0; return () => { a = (a + 0x6D2B79F5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
  const clamp = (v, a, b) => (v < a ? a : v > b ? b : v);
  const ease = (u) => { u = clamp(u, 0, 1); return u * u * (3 - 2 * u); };
  const lerp = (a, b, u) => a + (b - a) * u;
  const mix = (p, q, u) => ({ x: lerp(p.x, q.x, u), y: lerp(p.y, q.y, u) });
  const outBack = (u) => { u = clamp(u, 0, 1); const c1 = 1.70158, c3 = c1 + 1; return 1 + c3 * Math.pow(u - 1, 3) + c1 * Math.pow(u - 1, 2); };
  const vyber = (str, r) => str[Math.floor(r * str.length) % str.length];
  const rnd = Math.random;

  // robot z loga: maska hlavy s anténkou (jako v hero)
  const MASKA = [], MSET = new Set();
  for (let y = 3; y <= 13; y++) for (let x = 2; x <= 16; x++) if (Math.min(x - 2, 16 - x) + Math.min(y - 3, 13 - y) >= 2) { MASKA.push([x, y]); MSET.add(x + ',' + y); }
  for (const [x, y] of [[9, 2], [9, 1], [8, 0], [9, 0], [10, 0]]) { MASKA.push([x, y]); MSET.add(x + ',' + y); }
  const jeOkraj = (x, y) => !MSET.has((x + 1) + ',' + y) || !MSET.has((x - 1) + ',' + y) || !MSET.has(x + ',' + (y + 1)) || !MSET.has(x + ',' + (y - 1));

  const IKONA_X = ['XX...XX', 'XXX.XXX', '.XXXXX.', '..XXX..', '.XXXXX.', 'XXX.XXX', 'XX...XX'];
  const IKONA_OK = ['.......XX', '......XXX', '.....XXX.', 'XX..XXX..', 'XXXXXX...', '.XXXX....', '..XX.....'];
  // místa pro ryby na palubě (vlevo od robota): střed x od BX, posun dna, směr
  // modrý koš na palubě (vlevo od robota): střed od BX, šířka nahoře a dole v pixelech postav, výška
  const KOS = { x: -20, w: 14, wd: 11, h: 6 };
  // místa ryb v koši: posun od středu koše a od horního okraje (kladné = hlouběji v koši), směr
  const HROMADA = [{ x: -16, y: -1, d: 1 }, { x: 10, y: -1, d: -1 }, { x: -3, y: -5, d: -1 }, { x: 18, y: -6, d: 1 }, { x: -14, y: -9, d: 1 }, { x: 5, y: -10, d: -1 }];
  const ZAVINAC = ['.XXXXX.', 'X.....X', 'X.XXX.X', 'X.X.X.X', 'X.XXXX.', 'X......', '.XXXXX.'];
  const NC = 10, NR = 7;           // síť: počet ok
  const OX = 600, GX = 545, GY = 230; // síť ve vodě (střed) a vytažená síť (střed, horní okraj)

  function animace(canvas, tlacitko, druh) {
    const ctx = canvas.getContext('2d');
    const prompt = druh === 2 ? PROMPT_DLOUHY : PROMPT_KRATKY;
    const rychlostPsani = druh === 2 ? 0.028 : 0.09;
    const tPsani = 0.6, tOdeslano = tPsani + prompt.length * rychlostPsani + 0.4;
    let scale = 1, bezi = true, viditelna = true, posledni = 0;
    const A = { T: 0 };

    // ---------- stavba scény ----------
    function novaRyba(r, cer, x, y, vx) {
      const w = cer ? 5 : 4 + Math.floor(r() * 3), h = w >= 5 ? 3 : 2;
      return { cer, x, y, hy: y, vx, w, h, f: r() * 6, seed: Math.floor(r() * 999), dir: vx >= 0 ? 1 : -1, vert: false, vy: 0, st: 'plave',
        barva: cer ? B.red : [B.skyDeep, B.navy, B.blue2][Math.floor(r() * 3)] };
    }
    function noveDeti() {
      const r = rng(2026), deti = [];
      for (let i = 0; i < 5; i++) {
        const w = 4, h = 2 + Math.floor(r() * 2), tvar = [];
        for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) { if (w > 3 && y === 0 && (x === 0 || x === w - 1) && r() < 0.7) continue; tvar.push([x, y]); }
        if (r() < 0.55) tvar.push([Math.floor(w / 2), -1]);
        deti.push({ i, w, h, tvar, faze: r() * 6.28, seed: 100 + i * 37, slotX: BX - 35 * S + i * 24, y: 0, vy: 0, naZemi: true,
          dalsiSkok: 1 + r() * 5, st: 'paluba', x: 0, yb: 0, ryba: null, cil: null });
      }
      return deti;
    }
    function reset() {
      const r = rng(7 + druh * 13);
      A.t0 = A.T; A.s = 0; A.parts = []; A.hromada = []; A.bubliny = []; A.hotovo = false; A.konec = Infinity; A.zmizeni = 0;
      A.robot = { skok: 0, vy: 0, vzduch: false, rukaP: 0, rukaL: 0, skokV: Infinity };
      A.deti = noveDeti();
      A.ryby = [];
      const nahodne = (n, cer, oblast) => { for (let i = 0; i < n; i++) { const o = oblast || [0, LW, HL + 34, LH - 22]; A.ryby.push(novaRyba(r, cer, lerp(o[0], o[1], r()), lerp(o[2], o[3], r()), (12 + r() * 16) * (r() < 0.5 ? -1 : 1))); } };
      if (druh === 1) {
        nahodne(13, false); nahodne(3, true, [20, 420, HL + 60, LH - 30]);
        A.ryba1 = novaRyba(r, false, 600, 402, -8); A.ryba1.w = 5; A.ryba1.h = 3; A.ryba1.barva = B.navy;
        A.ryba2 = novaRyba(r, true, 660, 470, 7);
        A.ryby.push(A.ryba1, A.ryba2);
        A.prut = { st: 'klid', t0: 0, ang: 58, ohyb: 0, hacek: { x: 0, y: 0 }, ryba: null, hod: 0, cil: null };
      } else if (druh === 2) {
        nahodne(9, false); nahodne(2, true, [20, 400, HL + 60, LH - 30]);
        for (const [x, y, vx] of [[540, 388, 6], [620, 432, -5], [572, 474, 4]]) A.ryby.push(novaRyba(r, true, x, y, vx));
        for (const [x, y, vx] of [[515, 445, 5], [652, 396, -6], [598, 410, 7], [660, 468, -4]]) A.ryby.push(novaRyba(r, false, x, y, vx));
        A.sit = { st: 'drzi', t0: 0, otevreni: 0, L: 0, F: 0, bx: 0, by: 0, chycene: [], tridit: 0, dalsi: 0 };
      } else {
        nahodne(14, false);
        for (const [x, y, vx] of [[478, 384, 8], [568, 500, -7], [650, 418, 6], [728, 520, -6], [612, 556, 5]]) A.ryby.push(novaRyba(r, true, x, y, vx));
      }
    }

    // ---------- souřadnice ----------
    const paluba = () => HL - 3 * S + Math.round(Math.sin(A.T * 1.3) * 2);
    const robotXY = () => ({ x0: BX + Math.round(4.5 * S), y0: Math.round(paluba() - 19 * S + A.robot.skok) });
    const ruka = () => { const R = robotXY(); return { x: R.x0 + 18.5 * S, y: R.y0 + (8 - Math.round(A.robot.rukaP) + 0.5) * S }; };
    const okrajKose = () => paluba() - KOS.h * S;
    const hromadaPos = (i) => { const p = HROMADA[i % HROMADA.length]; return { x: BX + KOS.x + p.x, y: okrajKose() + p.y, dir: p.d }; };
    const stredDitete = (d) => ({ x: d.x + d.w * S / 2, y: d.yb - (d.h + 2) * S / 2 });

    // ---------- částice ----------
    function cakanec(x, y, n) {
      for (let i = 0; i < n; i++) A.parts.push({ x: x + (rnd() - 0.5) * 10, y: y - 2, vx: (rnd() - 0.5) * 110, vy: -50 - rnd() * 110, g: 420, t: 0, zivot: 0.6 + rnd() * 0.35, ch: vyber(".'`o:", rnd()), c: rnd() < 0.5 ? B.skyDeep : B.navy });
      A.parts.push({ kruh: true, x, y: HL, t: 0, zivot: 0.9 });
    }
    const bublinka = (x, y) => A.parts.push({ x, y, vx: (rnd() - 0.5) * 8, vy: -26 - rnd() * 18, g: 0, t: 0, zivot: 1.4, ch: vyber('o.°', rnd()), c: B.white, voda: true });
    const kapka = (x, y) => A.parts.push({ x, y, vx: (rnd() - 0.5) * 6, vy: 0, g: 520, t: 0, zivot: 0.9, ch: vyber(".'", rnd()), c: B.skyDeep, kapka: true });

    function uspech() {
      if (A.hotovo) return;
      A.hotovo = true;
      A.bubliny.push({ typ: 'ok', t0: A.T + 0.1, dur: 2.3 });
      A.robot.skokV = A.T + 0.15;
      A.deti.forEach((d, i) => { if (d.st === 'paluba') d.dalsiSkok = A.T + 0.25 + i * 0.12; });
      A.konec = A.T + 3;
    }

    // ---------- ryby ----------
    function plavej(f, dt, k = 1) {
      f.x += f.vx * k * dt; f.dir = f.vx >= 0 ? 1 : -1;
      f.y += (f.hy - f.y) * Math.min(1, dt * 0.6) + Math.sin(A.T * 1.2 + f.f) * 0.1;
      if (f.x > LW + 40) f.x = -40; if (f.x < -40) f.x = LW + 40;
    }
    function ridit(o, tx, ty, v, dt) {
      const dx = tx - o.x, dy = ty - o.y, d = Math.hypot(dx, dy);
      if (d < 0.001) return 0;
      const k = Math.min(1, (v * dt) / d); o.x += dx * k; o.y += dy * k;
      if (Math.abs(dx) > 1.5) o.dir = dx > 0 ? 1 : -1;
      return d;
    }
    function aktualizujRyby(dt) {
      for (const f of A.ryby) {
        if (f.st === 'plave') plavej(f, dt, f.cer && f.vybrana ? 0.5 : 1);
        else if (f.st === 'pada') {
          f.vy += 600 * dt; f.y += f.vy * dt;
          if (f.y >= HL && f.vy > 0 && !f.dopad) { f.dopad = true; cakanec(f.x, HL, 8); }
          if (f.y >= HL + 24) { f.st = 'plave'; f.vert = false; f.vy = 0; f.dopad = false; f.vx = 46; f.hy = HL + 70 + rnd() * 110; }
        } else if (f.st === 'leti') {
          const u = clamp((A.T - f.t0) / f.dur, 0, 1), cil = hromadaPos(f.slot);
          f.x = lerp(f.od.x, cil.x, u); f.y = lerp(f.od.y, cil.y, u) - Math.sin(Math.PI * u) * f.oblouk; f.vert = false;
          if (u >= 1) { f.st = 'hromada'; A.hromada.push(f); }
        } else if (f.st === 'hromada') {
          const p = hromadaPos(f.slot); f.x = p.x; f.y = p.y; f.dir = p.dir; f.vert = false;
        }
      }
    }
    function posliNaHromadu(f, oblouk, dur) {
      f.st = 'leti'; f.t0 = A.T; f.dur = dur; f.od = { x: f.x, y: f.y }; f.oblouk = oblouk;
      f.slot = A.hromada.length + A.ryby.filter((g) => g.st === 'leti').length - 1;
    }

    // ---------- fáze 1: prut ----------
    function prutGeom() {
      const R = robotXY(), P = A.prut;
      const gx = 19, gy = 7 - Math.round(A.robot.rukaP), L = 26;
      const a = (P.ang * Math.PI) / 180, dx = Math.cos(a), dy = -Math.sin(a), qx = Math.sin(a), qy = Math.cos(a);
      const bunky = [], videne = new Set();
      for (let i = 0; i <= L * 2; i++) {
        const u = i / (L * 2);
        const cx = Math.round(gx + u * L * dx + P.ohyb * u * u * qx), cy = Math.round(gy + u * L * dy + P.ohyb * u * u * qy);
        const k = cx + ',' + cy; if (!videne.has(k)) { videne.add(k); bunky.push([cx, cy]); }
      }
      const posl = bunky[bunky.length - 1];
      return { bunky, R, spicka: { x: R.x0 + (posl[0] + 0.5) * S, y: R.y0 + (posl[1] + 0.5) * S } };
    }
    function nahod(c) { const P = A.prut; P.st = 'naprah'; P.t0 = A.T; P.hod = c; P.cil = c === 1 ? A.ryba1 : A.ryba2; P.dopadX = c === 1 ? 560 : 640; P.hloubka = c === 1 ? 405 : 470; }
    function faze1(dt) {
      const P = A.prut;
      if (A.s >= tOdeslano + 0.4 && P.hod === 0) nahod(1);
      const sp = prutGeom().spicka, u = A.T - P.t0;
      switch (P.st) {
        case 'klid': P.ang = 58 + Math.sin(A.T * 1.3) * 3; P.ohyb = 0; A.robot.rukaP = lerp(A.robot.rukaP, 0, Math.min(1, dt * 6)); P.hacek = { x: sp.x + 4 + Math.sin(A.T * 2) * 2, y: sp.y + 30 }; break;
        case 'naprah': { const k = ease(u / 0.45); P.ang = lerp(58, 125, k); A.robot.rukaP = 3 * k; P.hacek = { x: sp.x + 4, y: sp.y + 28 }; if (u >= 0.45) { P.st = 'svih'; P.t0 = A.T; } break; }
