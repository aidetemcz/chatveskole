---
import { navigace } from '../lib/data';
import { url } from '../lib/url';
---
<footer class="site-footer">
  <div class="wrap siroka">
    <div class="cols">
      {navigace.menu.map((g) => (
        <div>
          <h2>{g.title}</h2>
          <ul>{g.items.map((it) => <li><a href={url(it.href)}>{it.title}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="sign">
      <span>Chatboti ve škole · projekt neziskové organizace <a href="https://aidetem.cz">AI dětem, z. s.</a></span>
      <span>Obsah webu se mění spolu s chatboty — u stránek najdete datum aktualizace.</span>
    </div>
  </div>
</footer>

<style>
  /* patička přes celou šířku okna, stejně jako hlavička */
  .siroka { max-width: none; padding-left: 32px; padding-right: 32px; }
  @media (max-width: 640px) { .siroka { padding-left: 16px; padding-right: 16px; } }
  .site-footer { border-top: 1px solid var(--line); padding: 64px 0 40px; font-size: 0.88rem; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 32px; }
  h2 { font-family: var(--fb); font-size: 0.95rem; font-weight: 600; margin-bottom: 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
  .cols a { color: var(--muted); text-decoration: none; }
  .cols a:hover { color: var(--ink); text-decoration: underline; }
  .sign { border-top: 1px solid var(--line); margin-top: 40px; padding-top: 24px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; font-size: 0.8rem; color: var(--muted); }
  .sign a { color: var(--muted); }
</style>
