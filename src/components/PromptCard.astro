---
import { url } from '../lib/url';
import { t } from '../lib/jazyk';
interface Props { title: string; href: string; text: string; id: string; skill?: boolean; popis?: string | null }
const { title, href, text, id, skill, popis } = Astro.props;
---
<article class="card">
  <div class="card-top">
    <h3><a href={url(href)}>{title}</a></h3>
    {skill && <span class="badge badge--sky" data-pagefind-ignore>{t('i jako dovednost')}</span>}
  </div>
  {popis && <p>{popis}</p>}
  <div class="actions" data-pagefind-ignore>
    <a class="linkbtn" href={url(href)}>{t('Detail promptu →')}</a>
  </div>
</article>
