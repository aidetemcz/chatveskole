---
import { url } from '../lib/url';
interface Props { title: string; href: string; text: string; id: string; skill?: boolean }
const { title, href, text, id, skill } = Astro.props;
---
<article class="card">
  <div class="card-top">
    <h3><a href={url(href)}>{title}</a></h3>
    {skill && <span class="badge badge--sky" data-pagefind-ignore>i jako dovednost</span>}
  </div>
  <div class="actions" data-pagefind-ignore>
    <a class="linkbtn" href={url(href)}>Detail promptu →</a>
  </div>
</article>
