---
// Cookie lišta a Google Analytics 4 (G-G1NT8MV18D, schválila Eva 21. 11. 2026, kvůli napojení na Looker Studio).
// GA4 se načte až po souhlasu (Consent Mode v2, výchozí stav „odmítnuto“, reklamní úložiště vždy odmítnuto).
// První úroveň: Přijmout / Přizpůsobit (rozhodla Eva 21. 11. 2026); v Přizpůsobit přepínač analytických cookies.
// Volba se ukládá v localStorage; změnit ji jde tlačítkem „Nastavení cookies“ v patičce ([data-cookies-nastaveni]).
// Lišta i měření jen v produkčním buildu na Vercelu (prop zapnuto).
import { url } from '../lib/url';
import { t } from '../lib/jazyk';
interface Props { zapnuto: boolean }
const { zapnuto } = Astro.props;
const GA_ID = 'G-G1NT8MV18D';
---
{zapnuto && (
  <>
    <div class="cookie-lista" id="cookie-lista" role="region" aria-label={t('Souhlas s cookies')} hidden data-pagefind-ignore>
      <p>{t('Rádi bychom měřili návštěvnost pomocí Google Analytics, abychom věděli, které stránky vám pomáhají. Analytické cookies použijeme jen s vaším souhlasem. Volbu můžete kdykoli změnit v patičce webu. Více v')} <a href={url('/o-webu/ochrana-soukromi')}>{t('Ochraně soukromí')}</a>.</p>
      <div class="cookie-tlacitka" data-cookies-zaklad>
        <button type="button" class="btn btn--primary" data-cookies="ano">{t('Přijmout')}</button>
        <button type="button" class="btn btn--outline" data-cookies-prizpusobit>{t('Přizpůsobit')}</button>
      </div>
      <div class="cookie-nastaveni" data-cookies-panel hidden>
        <div class="cookie-volba">
          <div>
            <strong>{t('Nezbytné')}</strong>
            <span>{t('Web si pamatuje jen vaši volbu cookies a to, že jste viděli uvítací okno. Bez nich web nefunguje správně.')}</span>
          </div>
          <span class="cookie-stav">{t('Vždy zapnuto')}</span>
        </div>
        <label class="cookie-volba">
          <div>
            <strong>{t('Analytické (Google Analytics)')}</strong>
            <span>{t('Měříme, které stránky čtete a odkud přicházíte. Data nepoužíváme k reklamě.')}</span>
          </div>
          <input type="checkbox" data-cookies-analytika />
        </label>
        <div class="cookie-tlacitka">
          <button type="button" class="btn btn--primary" data-cookies-ulozit>{t('Uložit volbu')}</button>
          <button type="button" class="btn btn--outline" data-cookies="ano">{t('Přijmout vše')}</button>
        </div>
      </div>
    </div>
    <script is:inline define:vars={{ GA_ID }}>
      (function () {
        var KLIC = 'chatveskole-cookies';
        var lista = document.getElementById('cookie-lista');
        var volba = null;
        try { volba = localStorage.getItem(KLIC); } catch (e) {}
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
        var nacteno = false;
        function spust() {
          gtag('consent', 'update', { analytics_storage: 'granted' });
          if (nacteno) return;
          nacteno = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', GA_ID);
        }
        function uloz(v) { try { localStorage.setItem(KLIC, v); } catch (e) {} }
        function ukaz() {
          // nejdřív uvítací okno, pak lišta
          var modal = document.getElementById('novy-web');
          if (modal && modal.open) { modal.addEventListener('close', function () { lista.hidden = false; }, { once: true }); }
          else lista.hidden = false;
        }
        if (volba === 'ano') spust();
        // uvítací okno se otevírá skriptem modulu, ten běží až před DOMContentLoaded
        else if (volba !== 'ne') document.addEventListener('DOMContentLoaded', ukaz);
        var zaklad = lista.querySelector('[data-cookies-zaklad]');
        var panel = lista.querySelector('[data-cookies-panel]');
        var zaskrt = lista.querySelector('[data-cookies-analytika]');
        function nastaveni() {
          var aktualni = null;
          try { aktualni = localStorage.getItem(KLIC); } catch (e) {}
          zaskrt.checked = aktualni === 'ano';
          zaklad.hidden = true; panel.hidden = false; lista.hidden = false;
          zaskrt.focus();
        }
        function rozhodni(v) {
          uloz(v);
          lista.hidden = true; panel.hidden = true; zaklad.hidden = false;
          if (v === 'ano') spust();
          else if (nacteno) { gtag('consent', 'update', { analytics_storage: 'denied' }); }
        }
        lista.addEventListener('click', function (e) {
          if (e.target.closest('[data-cookies-prizpusobit]')) return nastaveni();
          if (e.target.closest('[data-cookies-ulozit]')) return rozhodni(zaskrt.checked ? 'ano' : 'ne');
          var b = e.target.closest('[data-cookies]');
          if (b) rozhodni(b.getAttribute('data-cookies'));
        });
        document.addEventListener('click', function (e) {
          if (e.target.closest('[data-cookies-nastaveni]')) nastaveni();
        });
      })();
    </script>
  </>
)}

<style>
  .cookie-lista { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 60; max-width: 760px; margin: 0 auto; background: var(--panel); border: 1px solid var(--sky); border-radius: 12px; box-shadow: 0 12px 40px rgba(28, 37, 48, 0.18); padding: 20px 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .cookie-lista[hidden] { display: none; }
  .cookie-lista p { margin: 0; flex: 1 1 360px; font-size: 0.93rem; line-height: 1.55; }
  .cookie-tlacitka { display: flex; flex-wrap: wrap; gap: 10px; }
  .cookie-tlacitka[hidden], .cookie-nastaveni[hidden] { display: none; }
  .cookie-nastaveni { flex: 1 1 100%; display: flex; flex-direction: column; gap: 12px; }
  .cookie-volba { display: flex; gap: 16px; align-items: center; justify-content: space-between; background: #f6fafc; border-radius: 9px; padding: 12px 16px; cursor: pointer; }
  .cookie-volba div { display: flex; flex-direction: column; gap: 2px; font-size: 0.9rem; line-height: 1.5; }
  .cookie-volba strong { font-weight: 600; }
  .cookie-volba input { flex: none; width: 22px; height: 22px; accent-color: var(--accent); }
  .cookie-stav { flex: none; font-size: 0.8rem; color: var(--sky-ink); font-weight: 600; }
</style>
