---
import { navigace } from '../lib/web';

// Kontakty, sítě a newsletter: content/stranky/o-webu/kontakt.md a patička starého webu.
const site = [
  { nazev: 'Facebook (skupina)', url: 'https://www.facebook.com/groups/aidetem/' },
  { nazev: 'LinkedIn', url: 'https://www.linkedin.com/company/aidetem/' },
  { nazev: 'X', url: 'https://x.com/ai_detem' },
  { nazev: 'YouTube', url: 'https://www.youtube.com/playlist?list=PLA-vu9VjrcjD1ZXdSoX2PRs3xcgfH0KCO' },
];
const newsletter = 'https://aidetem.ecomailapp.cz/public/form/2-2bb287d15897fe2f9d89c882af9a3a8b';
---
<footer class="paticka">
  <div class="wrap">
    <div class="paticka-mrizka">
      {navigace.menu.map((sekce, i) => (
        <nav aria-labelledby={`pat-${i}`}>
          <h2 id={`pat-${i}`}>{sekce.title}</h2>
          <ul>{sekce.items.map((p) => <li><a href={p.href}>{p.title}</a></li>)}</ul>
        </nav>
      ))}
      <div class="paticka-aidetem">
        <div>
          <h2>Novinky do e-mailu</h2>
          <p>Funkce chatbotů se mění každý měsíc. Pošleme vám, co je pro školy důležité.</p>
        </div>
        <a class="btn btn-accent" href={newsletter}>Přihlásit se k odběru</a>
        <div>
          <h2>Kontakt</h2>
          <ul>
            <li><a href="mailto:cau@aidetem.cz">cau@aidetem.cz</a></li>
            <li><a href="/o-webu/kontakt#poslat">Pošlete nám skill nebo prompt</a></li>
          </ul>
        </div>
        <div>
          <h2>Sledujte nás</h2>
          <ul class="socialni">{site.map((s) => <li><a href={s.url}>{s.nazev}</a></li>)}</ul>
        </div>
      </div>
    </div>
    <div class="paticka-spodek">
      <span><strong>AI dětem, z. s.</strong> · <a href="https://aidetem.cz">aidetem.cz</a> · IČ 17914582</span>
      <span>Funkce chatbotů se mění každý měsíc. Klíčové údaje si ověřte ve zdrojích.</span>
    </div>
  </div>
</footer>
