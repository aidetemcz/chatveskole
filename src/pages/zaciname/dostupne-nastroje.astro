---
// Dostupné nástroje (sablona: nastroje-pruvodce). Návrh z Claude Design (21. 11. 2026).
// Texty jsou v content/stranky/zaciname/dostupne-nastroje.md: ### nástroj = karta, tabulka = srovnání, seznam = další nástroje.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { rozdel, naOddily } from '../../lib/komponenty';
import { navigace } from '../../lib/data';
import { url } from '../../lib/url';

const stranka = (await getEntry('stranky', 'zaciname/dostupne-nastroje'))!;
const d = stranka.data;
const { uvod, oddily } = naOddily(rozdel(stranka.rendered?.html ?? ''));
const htmlOddilu = (o?: { casti: { typ: string; html?: string }[] }) => (o?.casti ?? []).filter((x) => x.typ === 'html').map((x) => x.html ?? '').join('');
const perex = uvod.map((c) => (c.typ === 'html' ? c.html : '')).join('');
const najdi = (r: RegExp) => oddily.find((o) => r.test(o.nadpis));
const bezTagu = (s: string) => s.replace(/<[^>]+>/g, '').trim();
const uvodOddilu = (h: string) => h.split(/<(?:ul|ol|h3|table)[\s>]/)[0];
const velke = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const bloky = (h: string) => h.split(/(?=<h3[\s>])/).filter((k) => /^\s*<h3/.test(k)).map((k) => {
  const m = k.match(/^\s*<h3[^>]*>([\s\S]*?)<\/h3>/)!;
  return { nazev: bezTagu(m[1]), html: k.slice(m.index! + m[0].length).trim() };
});

// Tabulka: první sloupec = vlastnost, další = nástroje
const tabulkaOddil = najdi(/tabulce/i);
const tabulkaHtml = htmlOddilu(tabulkaOddil);
const hlavicka = [...(tabulkaHtml.match(/<thead>([\s\S]*?)<\/thead>/)?.[1] ?? '').matchAll(/<th[^>]*>([\s\S]*?)<\/th>/g)].map(([, t]) => bezTagu(t)).slice(1);
const radkyVse = [...(tabulkaHtml.match(/<tbody>([\s\S]*?)<\/tbody>/)?.[1] ?? '').matchAll(/<tr>([\s\S]*?)<\/tr>/g)]
  .map(([, r]) => [...r.matchAll(/<td[^>]*>([\s\S]*?)<\/td>/g)].map(([, t]) => t.trim()))
  .map((b) => ({ nazev: bezTagu(b[0]).replace(/\s*—\s*/, ': '), bunky: b.slice(1) }));
const radek = (r: RegExp) => radkyVse.find((x) => r.test(x.nazev));
// skupiny řádků; Vývojář se ukazuje v kartách
const FUNKCE_OD = radkyVse.findIndex((x) => /Dovednosti/i.test(x.nazev));
const radky = radkyVse.filter((x) => !/Vývojář/i.test(x.nazev)).map((x) => ({ ...x, skupina: x === radkyVse.find((y) => /Zdarma/i.test(y.nazev)) ? 'Dostupnost' : x === radkyVse[FUNKCE_OD] ? 'Funkce' : '' }));
const bunka = (t: string) => velke(t.trim());

// Karty nástrojů: ### název → popis a odkaz; štítky z tabulky
const ctyri = najdi(/Čtyři/i);
const ctyriHtml = htmlOddilu(ctyri);
const vyvojar = radek(/Vývojář/i), skolni = radek(/Školní verze/i), vekOsobni = radek(/osobní/i), vekSkolni = radek(/školní účet/i);
const karty = bloky(ctyriHtml).map((b, i) => {
  const odkaz = b.html.match(/<p>\s*<a href="([^"]+)"[^>]*>([\s\S]*?)<\/a>\s*<\/p>/);
  const popis = odkaz ? b.html.replace(odkaz[0], '') : b.html;
  const sk = skolni ? bezTagu(skolni.bunky[i] ?? '') : '';
  const vek = vekOsobni ? bezTagu(vekOsobni.bunky[i] ?? '').match(/^\d+\+/)?.[0] : undefined;
  // školní účet bez věkového omezení (Gemini) → dva štítky
  const skolniVse = vekSkolni ? /bez věkového omezení/i.test(bezTagu(vekSkolni.bunky[i] ?? '')) : false;
  return { nazev: b.nazev, popis, odkaz: odkaz ? { href: odkaz[1], text: bezTagu(odkaz[2]) } : null,
    vyvojar: vyvojar ? bezTagu(vyvojar.bunky[i] ?? '') : '', skolni: /^ano/.test(sk), vek, skolniVse };
});

// Další nástroje: položky „**[Název](odkaz)** — text“ jako karty, ostatní jako tip
const dalsi = najdi(/Další nástroje/i);
const dalsiHtml = htmlOddilu(dalsi);
const polozkyDalsi = [...(dalsiHtml.match(/<ul>([\s\S]*?)<\/ul>/)?.[1] ?? '').matchAll(/<li>([\s\S]*?)<\/li>/g)].map(([, t]) => t.trim());
const dalsiKarty = polozkyDalsi.map((t) => t.match(/^<strong>\s*<a href="([^"]+)"[^>]*>([\s\S]*?)<\/a>\s*<\/strong>\s*([\s\S]*)$/)).filter((m): m is RegExpMatchArray => !!m).map((m) => {
  const zbytek = m[3].trim();
  const pozn = zbytek.match(/^\(([^)]*)\)\s*/);
  const text = (pozn ? zbytek.slice(pozn[0].length) : zbytek).replace(/^[—–-]\s*/, '');
  return { href: m[1], nazev: bezTagu(m[2]), pozn: pozn ? velke(pozn[1]) : '', text: velke(text), nase: !/^https?:/.test(m[1]) || /\/ve-vyuce\/tiny/.test(m[1]) };
});
const dalsiTipy = polozkyDalsi.filter((t) => !/^<strong>\s*<a /.test(t));
const domena = (h: string) => h.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const vyzva = najdi(/Kolik to stojí/i);
type Odkaz = { text: string; href: string };
const odkazy: Odkaz[] = (Array.isArray(d.odkazy) ? d.odkazy : []).filter((o: Odkaz) => o && o.href);
const skupina = navigace.menu.find((g) => g.items.some((i) => i.href === '/' + stranka.id));
const datum = d.aktualizovano ? d.aktualizovano.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'numeric', year: 'numeric' }) : null;
const sipka = '<path d="M7 17L17 7M9 7h8v8"></path>';
---
<Base title={d.title} description={d.popis ?? undefined}>
  <div class="band band--white">
    <div class="wrap hero">
      <div class="page-head">
        <div class="zahlavi">
          <Crumbs items={[...(skupina ? [{ title: skupina.title }] : []), { title: d.title }]} />
          {datum && <span class="draft">Aktualizováno {datum}</span>}
        </div>
        <h1>{d.title}</h1>
        <div class="lede perex" set:html={perex} />
        <div class="tlacitka">
          {tabulkaOddil && <a class="btn btn--primary" href={`#${tabulkaOddil.id}`}>{tabulkaOddil.nadpis} ↓</a>}
          {odkazy[0] && <a class="btn btn--outline" href={url(odkazy[0].href)}>{odkazy[0].text}</a>}
        </div>
      </div>
    </div>
  </div>

  {ctyri && (
    <section class="band band--sky" aria-labelledby={ctyri.id || undefined}>
      <div class="wrap stack" style="gap: 32px">
        <div class="hlava">
          <h2 id={ctyri.id || undefined}>{ctyri.nadpis}</h2>
          <div class="prose" set:html={uvodOddilu(ctyriHtml)} />
        </div>
        <div class="karty karty--4">
          {karty.map((k) => (
            <article class="card nastroj">
              <div class="nastroj-hlava">
                <h3>{k.nazev}</h3>
                {k.vyvojar && <span class="vyvojar">{k.vyvojar}</span>}
              </div>
              {k.vek && <div class="stitky">{k.skolniVse ? <><span class="stitek">Osobní účet {k.vek}</span><span class="stitek">Školní účet bez omezení věku</span></> : <span class="stitek">Věk {k.vek}</span>}</div>}
              <div class="nastroj-popis" set:html={k.popis} />
              {k.odkaz && <a class="more" href={k.odkaz.href} style="margin-top: auto">{k.odkaz.text} ↗</a>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {tabulkaOddil && (
    <section class="band band--white" id={tabulkaOddil.id || undefined} aria-labelledby={tabulkaOddil.id ? `${tabulkaOddil.id}-h` : undefined}>
      <div class="wrap stack" style="gap: 32px">
        <div class="hlava">
          <h2 id={tabulkaOddil.id ? `${tabulkaOddil.id}-h` : undefined}>{tabulkaOddil.nadpis}</h2>
          <div class="prose" set:html={uvodOddilu(tabulkaHtml)} />
        </div>
        <div class="tabulka-obal" role="region" aria-label={tabulkaOddil.nadpis} tabindex="0">
          <table class="srovnani">
            <thead>
              <tr><td></td>{hlavicka.map((h) => <th scope="col">{h}</th>)}</tr>
            </thead>
            <tbody>
              {radky.map((r) => (
                <>
                  {r.skupina && <tr class="skupina"><th scope="colgroup" colspan={hlavicka.length + 1}>{r.skupina}</th></tr>}
                  <tr>
                    <th scope="row">{r.nazev}</th>
                    {r.bunky.map((t) => <td set:html={bunka(t)} />)}
                  </tr>
                </>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {dalsi && (
    <section class="band band--sky" aria-labelledby={dalsi.id || undefined}>
      <div class="wrap stack" style="gap: 32px">
        <h2 id={dalsi.id || undefined}>{dalsi.nadpis}</h2>
        <div class="karty karty--3">
          {dalsiKarty.map((k) => (
            <div class:list={['card', { 'karta--nase': k.nase }]}>
              <h3>{k.nazev}</h3>
              {k.pozn && <span class="stitek">{k.pozn}</span>}
              <p set:html={k.text} />
              <a class="more" href={k.href} style="margin-top: auto">{k.nase ? `${k.nazev} →` : `${domena(k.href)} ↗`}</a>
            </div>
          ))}
        </div>
        {dalsiTipy.map((t) => (
          <div class="tip">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4M12 16h.01"></path></svg>
            <span set:html={t} />
          </div>
        ))}
      </div>
    </section>
  )}

  {vyzva && (
    <section class="band band--white" aria-labelledby={vyzva.id || undefined}>
      <div class="wrap vyzva">
        <div class="hlava">
          <h2 id={vyzva.id || undefined}>{vyzva.nadpis}</h2>
          <div class="prose" set:html={htmlOddilu(vyzva)} />
        </div>
        <div class="tlacitka">
          {odkazy.map((o, i) => <a class:list={['btn', i === 0 ? 'btn--primary' : 'btn--outline']} href={url(o.href)}>{o.text}{i === 0 && ' →'}</a>)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .hlava { display: flex; flex-direction: column; gap: 14px; max-width: 64ch; }
  .tlacitka { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .perex :global(p) { font-size: 1.15rem; }
  .stitek { align-self: flex-start; font-family: var(--fb); font-size: 0.75rem; padding: 2px 8px; border-radius: var(--pill); background: var(--sky-light); }
  .stitek--cerveny { background: var(--accent-soft); font-weight: 600; }
  .stitek--sedy { background: var(--line-soft); }

  .karty { display: grid; gap: 22px; }
  .karty--4 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  .karty--3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .nastroj-hlava { display: flex; flex-direction: column; gap: 2px; }
  .nastroj h3 { font-size: 1.35rem; }
  .vyvojar { font-size: 0.82rem; color: var(--sky-ink); }
  .stitky { display: flex; flex-wrap: wrap; gap: 6px; }
  .nastroj-popis :global(p) { margin: 0; font-size: 0.93rem; line-height: 1.6; color: var(--ink); }
  .karty--3 h3 { font-size: 1.2rem; }
  .karty--3 p { margin: 0; font-size: 0.93rem; color: var(--ink); }
  .karta--nase { background: var(--accent-soft); border-color: transparent; }
  .karta--nase .stitek { background: var(--panel); }

  .tabulka-obal { border: 1px solid var(--sky); border-radius: 9px; overflow-x: auto; background: var(--panel); }
  .srovnani { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 0.88rem; line-height: 1.5; }
  .srovnani thead tr { background: var(--sky-light); }
  .srovnani thead th { text-align: left; padding: 14px 20px; font-family: var(--fh); font-size: 1.05rem; }
  .srovnani tbody th[scope='row'] { text-align: left; padding: 12px 20px; font-weight: 600; background: #f6fafc; width: 22%; }
  .srovnani td { padding: 12px 20px; vertical-align: top; }
  .srovnani tbody tr { border-top: 1px solid var(--line); }
  .srovnani tr.skupina th { text-align: left; padding: 18px 20px 8px; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sky-ink); background: var(--panel); }

  .tip { background: var(--panel); border-radius: 9px; padding: 18px 22px; display: flex; gap: 12px; align-items: flex-start; font-size: 0.95rem; }
  .tip svg { flex: none; margin-top: 2px; color: var(--sky-ink); }

  .vyzva { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
</style>
