---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { t } from '../lib/jazyk';
---
<Base title={t('Stránka nenalezena')} noindex>
  <div class="band band--white">
    <div class="wrap page-head">
      <h1>{t('Stránka nenalezena')}</h1>
      <p class="lede">{t('Web Chatboti ve škole jsme přestavěli a některé stránky mají novou adresu. Zkuste hlavní stránku, katalog dovedností nebo katalog promptů.')}</p>
      <div style="display: flex; flex-wrap: wrap; gap: 16px">
        <a class="btn btn--primary" href={url('/')}>{t('Hlavní stránka')}</a>
        <a class="btn btn--outline" href={url('/skills')}>{t('Katalog dovedností')}</a>
        <a class="btn btn--outline" href={url('/prompty')}>{t('Katalog promptů')}</a>
      </div>
    </div>
  </div>
</Base>
