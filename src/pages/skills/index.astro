---
import OdkazyKonec from '../../components/OdkazyKonec.astro';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import SkillCard from '../../components/SkillCard.astro';
import { url } from '../../lib/url';
import { sady, skills, skillBySlug, PRO_KOHO_SKUPINA, pocet, type Skill } from '../../lib/data';

const podleUcelu = sady.map((s) => ({
  title: s.title, popis: s.popis, sada: s.slug,
  items: s.skills.map(skillBySlug).filter(Boolean) as Skill[],
}));
const podleKomu = Object.entries(PRO_KOHO_SKUPINA).map(([id, title]) => ({
  title, popis: '', sada: '',
  items: sady.flatMap((s) => s.skills).filter((v, i, a) => a.indexOf(v) === i)
    .map(skillBySlug).filter((k): k is Skill => !!k && k.pro_koho.includes(id)),
})).filter((g) => g.items.length > 0);
const views = [
  { id: 'ucel', groups: podleUcelu },
  { id: 'komu', groups: podleKomu },
];
---
<Base title="Katalog dovedností" description={`${pocet(skills.length, 'dovednost', 'dovednosti', 'dovedností')} pro vyučující a vedení škol ke stažení do Claude, Gemini, Copilotu a ChatGPT.`}>
  <div class="band band--white" style="padding-bottom: 32px">
    <div class="wrap stack" style="gap: 32px">
      <Crumbs items={[{ title: 'Funkce', href: '/funkce/skills' }, { title: 'Katalog dovedností' }]} />
      <header class="page-head">
        <h1>Katalog dovedností</h1>
        <p class="lede">{pocet(skills.length, 'dovednost', 'dovednosti', 'dovedností')} pro vyučující a vedení škol. Stáhněte dovednost a nainstalujte ji do Claude, Gemini, ChatGPT nebo Copilotu — chatbot ji pak použije, kdykoli ji budete potřebovat. Dovednosti nemá každý tarif; kde chybí, zkopírujte si dovednost jako prompt.</p>
      </header>
      <div class="seg" role="group" aria-label="Řazení" data-switch="skupiny-skills" style="align-self: flex-start">
        <button type="button" data-target="ucel" aria-pressed="true">Řadit podle účelu</button>
        <button type="button" data-target="komu" aria-pressed="false">Řadit podle toho, komu slouží</button>
      </div>
    </div>
  </div>

  <div id="skupiny-skills">
    {views.map((v) => (
      <div data-group-view={v.id} hidden={v.id !== 'ucel'} data-pagefind-ignore={v.id !== 'ucel' ? '' : undefined}>
        {v.groups.map((g, i) => (
          <section class={`band ${i % 2 === 0 ? 'band--sky' : 'band--white'}`} aria-label={g.title}>
            <div class="wrap stack" style="gap: 28px">
              <div class="section-head">
                <div class="stack" style="gap: 8px; max-width: var(--dve-tretiny)">
                  <h2 style="font-size: 1.7rem">{g.title} <span class="count">{pocet(g.items.length, 'dovednost', 'dovednosti', 'dovedností')}</span></h2>
                  {g.popis && <p style="margin-top: 0">{g.popis}</p>}
                </div>
              </div>
              <div class="grid-2">
                {g.items.map((k) => <SkillCard skill={k} />)}
              </div>
              {i === v.groups.length - 1 && <OdkazyKonec vSekci odkazy={[{ text: 'Co jsou dovednosti a jak je nainstalovat', href: url('/funkce/skills') }, { text: 'Katalog promptů', href: url('/prompty') }, { text: 'Sady dovedností (pluginy)', href: url('/funkce/pluginy') }]} />}
            </div>
          </section>
        ))}
      </div>
    ))}
  </div>
</Base>
