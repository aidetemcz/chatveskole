---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url';
import { skills, sadaBySlug, PRO_KOHO, ZIP, asList, type Skill } from '../../lib/data';
import { NASTROJE } from '../../lib/instalace';

export function getStaticPaths() {
  return skills.map((skill) => ({ params: { slug: skill.slug }, props: { skill } }));
}
const { skill } = Astro.props as { skill: Skill };
const sadyS = skill.sady.map(sadaBySlug).filter(Boolean) as { slug: string; title: string }[];
const hlavniSada = sadyS[0];
const zipFor = (z: string) => (z === 'copilot' ? ZIP.copilot(skill.slug) : z === 'plugin' && hlavniSada ? ZIP.plugin(hlavniSada.slug) : ZIP.skill(skill.slug));
const zipLabel = (z: string, nazev: string) => (z === 'plugin' && hlavniSada ? `Plugin sady ${hlavniSada.title}` : `ZIP pro ${nazev}`);
const zipNote = (z: string) => (z === 'copilot' ? `${skill.slug}-copilot.zip · SKILL.md v kořeni` : z === 'plugin' ? `aidetem-${hlavniSada?.slug}.zip · pro správce pracovního prostoru` : `${skill.slug}.zip · nerozbalujte`);
const gpt = asList(skill.puvodni_asistenti?.gpt);
const gem = asList(skill.puvodni_asistenti?.gem);
const varianty = skill.prompt.varianty;
---
<Base title={skill.title} description={skill.kratky_popis}>
  <div class="band band--white" style="padding-bottom: 28px">
    <div class="wrap stack" style="gap: 24px">
      <Crumbs items={[{ title: 'Katalog skills', href: '/skills' }, { title: skill.title }]} />
      <header class="page-head">
        <h1>{skill.title}</h1>
        <p class="lede">{skill.kratky_popis}</p>
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; padding-top: 6px">
          <a class="btn btn--primary" href="#instalace"><Icon name="download" size={16} />Stáhnout skill</a>
          <a class="linkbtn" href="#prompt" style="font-size: 1rem"><Icon name="copy" size={16} />Použít jako prompt</a>
        </div>
      </header>

      <section class="info" aria-label="O skillu">
        <div><h2>{sadyS.length > 1 ? 'Sady' : 'Sada'}</h2><p>{sadyS.map((s, i) => <>{i > 0 && ', '}<a href={url(`/sady/${s.slug}`)}>{s.title}</a></>)}</p></div>
        <div><h2>Pro koho</h2><p>{skill.pro_koho.map((p) => PRO_KOHO[p] ?? p).join(', ')}</p></div>
        {skill.metodika && skill.metodika.length > 0 && (
          <div><h2>Metodika</h2><p>{skill.metodika.map((m, i) => <>{i > 0 && '; '}{m.url ? <a href={m.url}>{m.nazev}</a> : m.nazev}</>)}</p></div>
        )}
        {skill.autori && <div><h2>{skill.autori.length > 1 ? 'Autoři' : 'Autor'}</h2><p>{skill.autori.join(', ')}</p></div>}
        {(skill.google_doc || skill.google_slozka) && (
          <div class="docs">
            {skill.google_doc && <a href={skill.google_doc}><Icon name="doc" size={18} />Systémový prompt (Google Docs)</a>}
            {skill.google_slozka && <a href={skill.google_slozka}><Icon name="folder" size={18} />Podklady na Google Disku</a>}
          </div>
        )}
      </section>

      {skill.rezimy && skill.rezimy.length > 0 && (
        <section class="stack" style="gap: 14px" aria-labelledby="umi">
          <h2 id="umi" class="h2">Co skill umí</h2>
          <ol class="modes">{skill.rezimy.map((r, i) => <li><span>{i + 1}</span>{r}</li>)}</ol>
        </section>
      )}

      <section id="instalace" class="stack" style="gap: 14px" aria-labelledby="inst-h">
        <div class="stack" style="gap: 6px"><h2 id="inst-h" class="h2">Nainstalovat jako skill</h2><p class="muted">Skill nainstalujete jednou a chatbot ho použije sám, kdykoli ho budete potřebovat.</p></div>
        <div class="seg tools" role="tablist" aria-label="Chatbot" data-switch="instalace-panely">
          {NASTROJE.map((n, i) => <button type="button" role="tab" data-target={n.id} aria-selected={i === 0 ? 'true' : 'false'}>{n.nazev}</button>)}
        </div>
        <div id="instalace-panely">
          {NASTROJE.map((n, i) => (
            <div data-group-view={n.id} hidden={i !== 0} class="inst" role="tabpanel" aria-label={n.nazev}>
              <ol class="steps">{n.kroky(skill.slug).map((k) => <li>{k}</li>)}</ol>
              <div class="stack" style="gap: 10px">
                <a class="zip" href={url(zipFor(n.zip))} download>
                  <span class="tile-icon tile-icon--sky"><Icon name="download" size={18} /></span>
                  <span class="stack"><strong>{zipLabel(n.zip, n.nazev)}</strong><span class="muted small">{zipNote(n.zip)}</span></span>
                </a>
                <p class="muted small">Skills jsou v Gemini a Claude určené uživatelům od 18 let. S žáky používejte verzi promptu nebo aplikaci <a href={url('/ve-vyuce/tiny')}>Tiny</a>.</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="prompt" class="stack" style="gap: 14px" aria-labelledby="prompt-h">
        <div class="stack" style="gap: 6px"><h2 id="prompt-h" class="h2">Použít jako prompt</h2><p class="muted">Funguje v jakémkoli chatbotu, i v bezplatné verzi. Údaje v hranatých závorkách nahraďte svými.</p></div>
        {varianty.length > 1 && (
          <div class="tabs" role="tablist" aria-label="Varianta promptu" data-switch="varianty">
            {varianty.map((v, i) => <button type="button" role="tab" data-target={`v${i}`} aria-selected={i === 0 ? 'true' : 'false'}>{v.nazev}</button>)}
          </div>
        )}
        <div id="varianty">
          {varianty.map((v, i) => (
            <div data-group-view={`v${i}`} hidden={i !== 0} class="prompt-block" role={varianty.length > 1 ? 'tabpanel' : undefined}>
              <div class="copy-row"><button type="button" class="copy-btn" data-copy={`varianta-${i}`}><Icon name="copy" /><span data-label>Kopírovat</span></button></div>
              <pre id={`varianta-${i}`}>{v.text}</pre>
            </div>
          ))}
        </div>
        {skill.prompt.tip && <p class="note note--info"><strong>Tip:</strong> {skill.prompt.tip.replace(/\*\*/g, '')}</p>}
      </section>

      {(gpt.length > 0 || gem.length > 0) && (
        <section class="note note--warn stack" style="gap: 8px; padding: 22px 24px; border-radius: var(--radius-lg)" aria-labelledby="puvod-h">
          <div style="display: flex; align-items: center; gap: 10px"><span class="badge badge--end">končí</span><h2 id="puvod-h" style="font-size: 1.1rem">Používali jste původního asistenta?</h2></div>
          <p>Skill nahrazuje původní {gpt.length > 0 && 'GPT'}{gpt.length > 0 && gem.length > 0 && ' a '}{gem.length > 0 && 'Gem'} z chatveskole.cz. GPTs přestanou fungovat 11. 12. 2026, Gems se od 17. 11. 2026 postupně mění na skills.</p>
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  .h2 { font-size: 1.5rem; font-weight: 700; }
  .muted { color: var(--muted); }
  .small { font-size: 0.86rem; }
  .info { border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 20px 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 18px 28px; font-size: 0.92rem; }
  .info h2 { font-family: var(--fb); font-size: 0.78rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .docs { display: flex; flex-direction: column; gap: 8px; }
  .docs a { display: flex; align-items: center; gap: 8px; font-weight: 600; text-decoration: none; }
  .modes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 12px; }
  .modes li { border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 18px; display: flex; gap: 12px; align-items: center; font-weight: 600; }
  .modes span { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--sky-light); color: var(--sky-ink); display: grid; place-items: center; font-family: var(--fh); font-weight: 700; font-size: 0.9rem; }
  .tools { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); max-width: 560px; }
  .tools button { padding: 9px 6px; }
  .inst { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 16px; align-items: start; }
  .steps { margin: 0; padding: 18px 22px 18px 42px; border: 1px solid var(--line); border-radius: var(--radius); display: flex; flex-direction: column; gap: 10px; }
  .zip { border: 1px solid var(--sky); border-radius: var(--radius); padding: 14px 18px; display: flex; gap: 14px; align-items: center; text-decoration: none; color: var(--ink); }
  .zip:hover { background: var(--sky-light); color: var(--ink); }
  .tabs { display: flex; flex-wrap: wrap; gap: 4px; border-bottom: 1px solid var(--line); }
  .tabs button { padding: 10px 14px; border: 0; background: none; font-weight: 600; color: var(--muted); border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .tabs button[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--accent-strong); }
</style>
