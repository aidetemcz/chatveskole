---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url';
import { skills, sadaBySlug, datumCesky, type Skill } from '../../lib/data';
import { NASTROJE } from '../../lib/instalace';
import OdkazyKonec from '../../components/OdkazyKonec.astro';
import QRCode from 'qrcode';

export function getStaticPaths() {
  return skills.map((skill) => ({ params: { slug: skill.slug }, props: { skill } }));
}
const { skill } = Astro.props as { skill: Skill };
// ZIPy pro jednotlivé chatboty jsou na Google Disku (meta.yaml → stahnout)
const zipFor = (z: string | null) => (z ? skill.stahnout?.[z as 'claude' | 'gemini' | 'chatgpt'] : undefined);
// podobné dovednosti: nejdřív ze stejné sady, pak pro stejnou cílovou skupinu
const ostatni = skills.filter((s) => s.slug !== skill.slug);
const skore = (s: Skill) => s.sady.filter((x) => skill.sady.includes(x)).length * 10 + s.pro_koho.filter((x) => skill.pro_koho.includes(x)).length;
// QR kód na složku dovednosti na Google Disku (vygeneruje se při buildu jako SVG)
const qrSvg = skill.google_slozka ? await QRCode.toString(skill.google_slozka, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#1c2530', light: '#ffffff' } }) : '';
const podobne = ostatni.map((s, i) => ({ s, k: skore(s), i })).sort((a, b) => b.k - a.k || a.i - b.i).slice(0, 4).map((x) => x.s);
const varianty = skill.prompt.varianty;
---
<Base title={skill.title} description={skill.kratky_popis}>
  <div class="band band--white" style="padding-bottom: 96px">
    <div class="wrap stack detail">
      <div class="zahlavi">
        <Crumbs items={[{ title: 'Katalog dovedností', href: '/skills' }, { title: skill.title }]} />
        {skill.aktualizovano && <span class="draft">Aktualizováno {datumCesky(skill.aktualizovano as unknown as string | Date)}</span>}
      </div>
      <div class="hlava">
        <header class="page-head">
          <h1>{skill.title}</h1>
          <p class="lede">{skill.popis ?? skill.kratky_popis}</p>
          {skill.rezimy && skill.rezimy.length > 0 && (
            <ul class="modes" aria-label="Co dovednost umí">{skill.rezimy.map((r) => <li>{r}</li>)}</ul>
          )}
        </header>
        {qrSvg && (
          <div class="qr">
            <button type="button" class="qr-btn" aria-haspopup="dialog" aria-controls="qr-dialog" data-qr-otevrit>
              <span class="qr-obr" set:html={qrSvg} aria-hidden="true" />
              <span class="qr-popis">Soubory dovednosti na Google Disku<span class="qr-zvetsit">Klikněte pro zvětšení</span></span>
            </button>
            <dialog id="qr-dialog" class="qr-dialog" aria-labelledby="qr-dialog-h">
              <h2 id="qr-dialog-h">{skill.title}: soubory na Google Disku</h2>
              <p>Naskenujte QR kód telefonem, nebo otevřete složku přímo.</p>
              <div class="qr-velky" set:html={qrSvg} role="img" aria-label={`QR kód s odkazem na složku dovednosti ${skill.title} na Google Disku`} />
              <div class="qr-akce">
                <a class="btn btn--primary" href={skill.google_slozka}>Otevřít složku</a>
                <button type="button" class="btn btn--outline" data-qr-zavrit>Zavřít</button>
              </div>
            </dialog>
          </div>
        )}
      </div>

      <section id="instalace" class="stack sekce" aria-labelledby="inst-h">
        <div class="stack" style="gap: 10px"><h2 id="inst-h" class="h2">Nainstalovat dovednost</h2><p class="muted">Dovednost nainstalujete jednou a chatbot ji buď použije sám, kdykoli ji bude potřebovat, případně ji můžete vyvolat přímo v chatu pomocí zavináče nebo lomítka. Dovednosti nemá každý tarif; kde chybí, použijte verzi promptu.</p></div>
        <div class="stack" style="gap: 12px">
          <p id="nastroj-h" class="vyber">Vyberte chatovací nástroj, který používáte.</p>
          <div class="tools" role="tablist" aria-labelledby="nastroj-h" data-switch="instalace-panely">
            {NASTROJE.map((n, i) => <button type="button" role="tab" data-target={n.id} aria-selected={i === 0 ? 'true' : 'false'}>{n.nazev}</button>)}
          </div>
        </div>
        <div id="instalace-panely">
          {NASTROJE.map((n, i) => (
            <div data-group-view={n.id} hidden={i !== 0} class="inst" role="tabpanel" aria-label={n.nazev}>
              <ol class="steps">{n.kroky.map((k) => <li>{k}</li>)}</ol>
              <div class="stack" style="gap: 14px">
                {zipFor(n.zip) ? (
                  <a class="zip" href={zipFor(n.zip)}>
                    <span class="tile-icon tile-icon--sky"><Icon name="download" size={18} /></span>
                    <span class="stack"><strong>ZIP pro {n.nazev}</strong><span class="muted small">stáhne se z Google Disku · nerozbalujte</span></span>
                  </a>
                ) : (
                  <div class="stack" style="gap: 10px">
                    {skill.google_doc && <a class="zip" href={skill.google_doc}><span class="tile-icon tile-icon--sky"><Icon name="doc" size={18} /></span><span class="stack"><strong>Instrukce</strong><span class="muted small">Google Docs · vložte do pokynů agenta</span></span></a>}
                    {skill.google_data && <a class="zip" href={skill.google_data}><span class="tile-icon tile-icon--sky"><Icon name="folder" size={18} /></span><span class="stack"><strong>Znalosti (složka Data)</strong><span class="muted small">Google Disk · nahrajte do agenta</span></span></a>}
                  </div>
                )}
                <p class="muted small">Dovednosti jsou v Gemini a Claude určené uživatelům od 18 let. S žáky používejte verzi promptu nebo aplikaci <a href={url('/ve-vyuce/tiny')}>Tiny</a>.</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="prompt" class="stack sekce" aria-labelledby="prompt-h">
        <div class="stack" style="gap: 8px"><h2 id="prompt-h" class="h2">Použít jako prompt</h2><p class="muted">Funguje v jakémkoli chatbotu, i v bezplatné verzi. Údaje v hranatých závorkách nahraďte svými.{skill.google_doc && <> Celé instrukce dovednosti najdete v <a href={skill.google_doc}>Google Docs</a>.</>}</p></div>
        {varianty.length > 1 && (
          <div class="tabs" role="tablist" aria-label="Varianta promptu" data-switch="varianty">
            {varianty.map((v, i) => <button type="button" role="tab" data-target={`v${i}`} aria-selected={i === 0 ? 'true' : 'false'}>{v.nazev}</button>)}
          </div>
        )}
        <div id="varianty">
          {varianty.map((v, i) => (
            <div data-group-view={`v${i}`} hidden={i !== 0} class="prompt-block" role={varianty.length > 1 ? 'tabpanel' : undefined}>
              <div class="copy-row"><button type="button" class="copy-btn" data-copy={`varianta-${i}`}><Icon name="copy" /><span data-label>Kopírovat</span></button></div>
              <pre id={`varianta-${i}`}>{v.text}</pre>
            </div>
          ))}
        </div>
        {skill.google_data && <p><a class="zip zip--inline" href={skill.google_data}><span class="tile-icon tile-icon--sky"><Icon name="folder" size={18} /></span><span class="stack"><strong>Stáhnout znalosti (složka Data)</strong><span class="muted small">Google Disk · nahrajte soubory do chatu spolu s promptem</span></span></a></p>}
      </section>


      <p><a class="btn btn--primary" href={url('/skills')}>← Zpět na katalog dovedností</a></p>
    </div>
  </div>

  {podobne.length > 0 && (
    <section class="band band--sky podobne" aria-labelledby="podobne-h">
      <div class="wrap stack" style="gap: 30px">
        <h2 id="podobne-h" class="h2">Podobné dovednosti</h2>
        <div class="podobne-mrizka">
          {podobne.map((p) => (
            <a class="podobna" href={url(`/skills/${p.slug}`)}>
              <span class="podobna-nazev">{p.title}</span>
              <span class="podobna-popis">{p.kratky_popis}</span>
            </a>
          ))}
        </div>
        <OdkazyKonec vSekci odkazy={[...skill.sady.map(sadaBySlug).filter(Boolean).map((x) => ({ text: `Sada ${x!.title}`, href: url(`/sady/${x!.slug}`) }))]} />
      </div>
    </section>
  )}
</Base>

<script>
  // QR kód: na klik se otevře zvětšený v modálním okně (klávesa Esc i klik mimo okno ho zavřou)
  const dlg = document.getElementById('qr-dialog') as HTMLDialogElement | null;
  document.querySelector('[data-qr-otevrit]')?.addEventListener('click', () => dlg?.showModal());
  document.querySelector('[data-qr-zavrit]')?.addEventListener('click', () => dlg?.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  .h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 700; }
  .muted { color: var(--muted); }
  .small { font-size: 0.86rem; }
  .detail { gap: 64px; }
  .hlava { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 32px 56px; align-items: start; }
  @media (max-width: 860px) { .hlava { grid-template-columns: 1fr; } }
  .qr-btn { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 18px; border: 1px solid var(--sky); border-radius: var(--radius-lg); background: var(--panel); cursor: zoom-in; text-align: center; color: var(--ink); font: inherit; }
  .qr-btn:hover { background: var(--sky-light); }
  .qr-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .qr-obr { display: block; width: 150px; height: 150px; }
  .qr-obr :global(svg), .qr-velky :global(svg) { display: block; width: 100%; height: 100%; }
  .qr-popis { font-size: 0.88rem; font-weight: 600; line-height: 1.35; display: flex; flex-direction: column; gap: 4px; }
  .qr-zvetsit { font-weight: 400; color: var(--muted); font-size: 0.8rem; }
  @media (max-width: 860px) { .qr { max-width: 220px; } }
  .qr-dialog { border: 0; border-radius: var(--radius-lg); padding: 32px; max-width: min(92vw, 440px); width: 100%; box-shadow: 0 20px 60px rgba(31, 63, 77, 0.25); }
  .qr-dialog::backdrop { background: rgba(28, 37, 48, 0.55); }
  .qr-dialog h2 { font-size: 1.25rem; margin-bottom: 8px; }
  .qr-dialog p { font-size: 0.95rem; margin-bottom: 18px; }
  .qr-velky { width: 100%; max-width: 320px; aspect-ratio: 1; margin: 0 auto 22px; }
  .qr-akce { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .sekce { gap: 28px; }
  .modes { margin: 4px 0 0; padding-left: 1.3em; display: flex; flex-direction: column; gap: 8px; font-size: 1.05rem; }
  .modes li::marker { color: var(--ink); }
  .docs { display: flex; flex-direction: column; gap: 8px; }
  .vyber { font-weight: 600; }
  .tools { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; max-width: 680px; }
  .tools button { padding: 14px 10px; border: 1px solid var(--sky); border-radius: var(--pill); background: var(--panel); font-weight: 600; font-size: 1rem; color: var(--ink); cursor: pointer; }
  .tools button:hover { background: var(--sky-light); }
  .tools button[aria-selected='true'] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .tools button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  @media (max-width: 560px) { .tools { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .inst { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  @media (max-width: 860px) { .inst { grid-template-columns: 1fr; } }
  .steps { margin: 0; padding: 26px 30px 26px 50px; border: 1px solid var(--sky); border-radius: var(--radius); display: flex; flex-direction: column; gap: 14px; }
  .zip { border: 1px solid var(--sky); border-radius: var(--radius); padding: 18px 22px; display: flex; gap: 14px; align-items: center; text-decoration: none; color: var(--ink); }
  .zip--inline { display: inline-flex; }
  .podobne-mrizka { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  @media (max-width: 1000px) { .podobne-mrizka { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .podobne-mrizka { grid-template-columns: minmax(0, 1fr); } }
  .podobna { background: var(--panel); border: 1px solid var(--sky); border-radius: var(--radius-lg); padding: 26px; display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--ink); }
  .podobna-nazev { font-family: var(--fh); font-weight: 700; font-size: 1.1rem; line-height: 1.3; }
  .podobna:hover .podobna-nazev { color: var(--accent-strong); }
  .podobna-popis { font-size: 0.92rem; line-height: 1.5; }
  .zip:hover { background: var(--sky-light); color: var(--ink); }
  .tabs { display: flex; flex-wrap: wrap; gap: 4px; border-bottom: 1px solid var(--line); }
  .tabs button { padding: 10px 14px; border: 0; background: none; font-weight: 600; color: var(--muted); border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .tabs button[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--accent-strong); }
</style>
