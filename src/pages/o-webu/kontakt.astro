---
// Kontakt — komu a kam psát, formuláře, údaje o spolku (sablona: kontakt-pruvodce).
// Texty jsou v content/stranky/o-webu/kontakt.md (oddíly podle ##), grafika stejná jako u stránky Projekty.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { rozdel, naOddily } from '../../lib/komponenty';
import { url } from '../../lib/url';

const stranka = (await getEntry('stranky', 'o-webu/kontakt'))!;
const d = stranka.data;
const { uvod, oddily } = naOddily(rozdel(stranka.rendered?.html ?? ''));
const htmlOddilu = (o?: { casti: { typ: string; html?: string }[] }) => (o?.casti ?? []).filter((x) => x.typ === 'html').map((x) => x.html ?? '').join('');
const uvodHtml = uvod.map((c) => (c.typ === 'html' ? c.html : '')).join('').trim();
const odstavce = (h: string) => [...h.matchAll(/<p>([\s\S]*?)<\/p>/g)].map(([, t]) => t.trim());
const jenOdkazy = (p: string) => /^(\s*<a [^>]*>[\s\S]*?<\/a>\s*[·|]?)+$/.test(p);
// odkaz z Markdownu → tlačítko; zachová atributy (nové okno) i skrytý text pro čtečky
const naTlacitko = (a: string, trida: string, sipka = true) => {
  const s = a.replace(/^<a /, `<a class="btn ${trida}" `);
  if (!sipka) return s;
  const i = s.search(/<span class="sr-only"|<\/a>$/);
  return s.slice(0, i) + ' →' + s.slice(i);
};
const odkazyVOdstavci = (p: string) => [...p.matchAll(/<a [^>]*>[\s\S]*?<\/a>/g)].map(([a]) => a);

// Oddíly → karty: odstavce textu a odstavec jen s odkazem jako tlačítko; poslední oddíl (údaje o spolku) zvlášť
const jeSpolek = (o: { nadpis: string }) => /z\.\s*s\./i.test(o.nadpis);
const karty = oddily.filter((o) => !jeSpolek(o)).map((o) => {
  const p = odstavce(htmlOddilu(o));
  return { nadpis: o.nadpis, id: o.id, akce: false, text: p.filter((x) => !jenOdkazy(x)), tlacitka: p.filter(jenOdkazy).flatMap(odkazyVOdstavci) };
});
// první oddíl s tlačítkem (formulář pro dovednosti) je zvýrazněný
const akce = karty.find((k) => k.tlacitka.length);
if (akce) akce.akce = true;
const spolek = oddily.find(jeSpolek);
const udaje = odstavce(htmlOddilu(spolek)).flatMap((p) => p.split(/\s*·\s*/))
  .map((u) => u.match(/^([^:]+):\s*([\s\S]+)$/)).filter((m): m is RegExpMatchArray => !!m)
  .map((m) => ({ nazev: m[1].trim(), hodnota: m[2].trim() }));

type Odkaz = { text: string; href: string };
const odkazy: Odkaz[] = (Array.isArray(d.odkazy) ? d.odkazy : []).filter((o: Odkaz) => o && o.href);
const datum = d.aktualizovano ? d.aktualizovano.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'numeric', year: 'numeric' }) : null;
---
<Base title={d.title} description={d.popis ?? undefined}>
  <div class="band band--white">
    <div class="wrap hero">
      <div class="page-head">
        <div class="zahlavi">
          <Crumbs items={[{ title: d.menu ?? 'O webu' }, { title: d.menu_titulek ?? d.title }]} />
          {datum && <span class="draft">Aktualizováno {datum}</span>}
        </div>
        <h1>{d.title}</h1>
        {uvodHtml ? <div class="lede perex" set:html={uvodHtml} /> : d.popis && <p class="lede perex">{d.popis}</p>}
      </div>
    </div>
  </div>

  <section class="band band--sky" aria-label="Komu napsat">
    <div class="wrap">
      <div class="karty">
        {karty.map((k) => (
          <div class:list={['card', { 'card--akce': k.akce }]} id={k.id || undefined}>
            <h2>{k.nadpis}</h2>
            {k.text.map((p) => <p set:html={p} />)}
            {k.tlacitka.length > 0 && (
              <div class="tlacitka">
                {k.tlacitka.map((a) => <Fragment set:html={naTlacitko(a, k.akce ? 'btn--primary' : 'btn--outline btn--bila')} />)}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--white" aria-labelledby={spolek ? 'spolek-h' : undefined} aria-label={spolek ? undefined : 'Kam dál'}>
    <div class="wrap dva-sloupce">
      {spolek && (
        <div class="stack" style="gap: 20px">
          <h2 id="spolek-h">{spolek.nadpis}</h2>
          <dl class="tabulka">
            {udaje.map((u) => (
              <div class="radek">
                <dt>{u.nazev}</dt>
                <dd set:html={u.hodnota} />
              </div>
            ))}
          </dl>
        </div>
      )}
      {odkazy.length > 0 && (
        <nav class="kam-dal" aria-label="Kam dál">
          {odkazy.map((o, i) => <a class:list={['btn', i === 0 ? 'btn--primary' : 'btn--outline']} href={url(o.href)}>{o.text} →</a>)}
        </nav>
      )}
    </div>
  </section>
</Base>

<style>
  .perex { font-size: 1.15rem; }
  .perex :global(p) { font-size: 1.15rem; }
  .tlacitka { display: flex; flex-wrap: wrap; gap: 12px; margin-top: auto; padding-top: 6px; }
  .dva-sloupce { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 48px; align-items: end; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); }

  .karty { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 22px; }
  .karty .card { scroll-margin-top: 100px; }
  .karty .card h2 { font-size: 1.3rem; }
  .karty .card p { font-size: 0.95rem; line-height: 1.6; color: var(--ink); }
  .card--akce { background: var(--accent-soft); border-color: var(--accent-soft); }

  .tabulka { margin: 0; border: 1px solid var(--sky); border-radius: 9px; overflow: hidden; background: var(--panel); }
  .radek { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
  .radek + .radek { border-top: 1px solid #d5e5eb; }
  .radek > * { margin: 0; padding: 18px 26px; }
  .radek dt { background: #f6fafc; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sky-ink); display: flex; align-items: center; }
  .radek dd { font-family: var(--fh); font-size: 1.1rem; font-weight: 600; overflow-wrap: anywhere; }
  @media (max-width: 480px) {
    .radek { grid-template-columns: 1fr; }
    .radek dt { padding-bottom: 6px; }
    .radek dd { padding-top: 10px; }
  }

  .kam-dal { display: flex; flex-wrap: wrap; gap: 12px 14px; }
  .btn--bila { background: var(--panel); }
</style>
