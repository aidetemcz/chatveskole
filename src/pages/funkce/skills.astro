---
// Dovednosti (skills) — co to je, instalace a jak napsat vlastní (sablona: dovednosti-pruvodce). Návrh z Claude Design (20. 11. 2026).
// Texty jsou v content/stranky/funkce/skills.md (oddíly podle ##, nástroje a kroky podle ###).
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { rozdel, naOddily } from '../../lib/komponenty';
import { url } from '../../lib/url';

const stranka = (await getEntry('stranky', 'funkce/skills'))!;
const d = stranka.data;
const { uvod, oddily } = naOddily(rozdel(stranka.rendered?.html ?? ''));
const htmlOddilu = (o?: { casti: { typ: string; html?: string }[] }) => (o?.casti ?? []).filter((x) => x.typ === 'html').map((x) => x.html ?? '').join('');
const uvodHtml = uvod.map((c) => (c.typ === 'html' ? c.html : '')).join('');
// video (komponenta „video“) v úvodu se ukáže pod tlačítky s vlastním nadpisem
const videoHtml = (uvodHtml.match(/<div class="video">[\s\S]*?<\/div>/) ?? [''])[0];
const perex = videoHtml ? uvodHtml.replace(videoHtml, '') : uvodHtml;
const najdi = (r: RegExp) => oddily.find((o) => r.test(o.nadpis));
const bezTagu = (s: string) => s.replace(/<[^>]+>/g, '').trim();
// odstavce před prvním seznamem / nadpisem ###
const uvodOddilu = (h: string) => h.split(/<(?:ul|ol|h3)[\s>]/)[0];
// položky „**Název** — text“
const polozky = (h: string) => [...(h.match(/<ul>([\s\S]*?)<\/ul>/)?.[1] ?? '').matchAll(/<li>\s*<strong>([\s\S]*?)<\/strong>\s*[—–-]?\s*([\s\S]*?)<\/li>/g)]
  .map(([, n, t]) => ({ nazev: bezTagu(n).replace(/[.:]$/, ''), text: t.trim() }));
// rozdělení podle ### na bloky { nazev, html }
const bloky = (h: string) => h.split(/(?=<h3[\s>])/).filter((k) => /^\s*<h3/.test(k)).map((k) => {
  const m = k.match(/^\s*<h3[^>]*>([\s\S]*?)<\/h3>/)!;
  return { nazev: bezTagu(m[1]), html: k.slice(m.index! + m[0].length).trim() };
});

const skladba = najdi(/skládá/i);
const skladbaHtml = htmlOddilu(skladba);
const castiSkladby = polozky(skladbaHtml);

const zWebu = najdi(/z tohoto webu/i);
const zWebuHtml = htmlOddilu(zWebu);
const cesty = polozky(zWebuHtml);
const IKONY_CEST = [
  '<rect x="8" y="8" width="12" height="12" rx="2"></rect><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"></path>',
  '<path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path>',
  '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6M8 13h8M8 17h5"></path>',
  '<path d="M4 6c0-1.1 3.6-2 8-2s8 .9 8 2-3.6 2-8 2-8-.9-8-2z"></path><path d="M4 6v12c0 1.1 3.6 2 8 2s8-.9 8-2V6"></path><path d="M4 12c0 1.1 3.6 2 8 2s8-.9 8-2"></path>',
];

// Instalace: ### nástroj → kroky (seznam) a podmínky (odstavce)
const instalace = najdi(/nainstalovat/i);
const nastroje = bloky(htmlOddilu(instalace)).map((b, i) => {
  const seznam = b.html.match(/<(ol|ul)>([\s\S]*?)<\/\1>/);
  const kroky = seznam ? [...seznam[2].matchAll(/<li>([\s\S]*?)<\/li>/g)].map(([, t]) => t.trim()) : [];
  const podminky = [...b.html.replace(seznam?.[0] ?? '', '').matchAll(/<p>([\s\S]*?)<\/p>/g)].map(([, t]) => t);
  return { ...b, id: `nastroj-${i}`, kroky, podminky };
});

// Vlastní dovednost: ### krok → první odstavec na kartu, citace jako ukázka, zbytek do „Podrobnosti“
const vlastni = najdi(/vlastní/i);
const vlastniHtml = htmlOddilu(vlastni);
const kroky = bloky(vlastniHtml).map((b) => {
  const prvni = b.html.match(/^\s*<p>([\s\S]*?)<\/p>/);
  const ukazka = b.html.match(/<blockquote>\s*<p>([\s\S]*?)<\/p>\s*<\/blockquote>/);
  let zbytek = b.html;
  if (prvni) zbytek = zbytek.replace(prvni[0], '');
  if (ukazka) zbytek = zbytek.replace(ukazka[0], '');
  return { nazev: b.nazev, perex: prvni?.[1] ?? '', ukazka: ukazka?.[1] ?? '', zbytek: zbytek.trim() };
});

const vyzva = najdi(/vlastní dovednost\?/i) ?? oddily[oddily.length - 1];
const katalog = d.tlacitko && typeof d.tlacitko === 'object' && (d.tlacitko as { href?: string }).href ? (d.tlacitko as { text: string; href: string }) : { text: 'Katalog dovedností', href: '/skills' };
const datum = d.aktualizovano ? d.aktualizovano.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'numeric', year: 'numeric' }) : null;
---
<Base title={d.title} description={d.popis ?? undefined}>
  <div class="band band--white">
    <div class="wrap hero">
      <div class="page-head">
        <div class="zahlavi">
          <Crumbs items={[{ title: 'Funkce' }, { title: d.title }]} />
          {datum && <span class="draft">Aktualizováno {datum}</span>}
        </div>
        <h1>{d.title}</h1>
        <div class="lede perex" set:html={perex} />
        <div class="tlacitka">
          <a class="btn btn--primary" href={url(katalog.href)}>{katalog.text} →</a>
          {instalace && <a class="btn btn--outline" href={`#${instalace.id}`}>Jak ji nainstalovat ↓</a>}
        </div>
      </div>
      {videoHtml && (
        <div class="video-uvod stack" style="gap: 30px">
          <h2 id="pruvodce">Průvodce instalací a využitím dovednosti</h2>
          <div set:html={videoHtml} />
        </div>
      )}
    </div>
  </div>

  {skladba && (
    <section class="band band--sky" aria-labelledby={skladba.id || undefined}>
      <div class="wrap dva-sloupce">
        <div class="hlava">
          <h2 id={skladba.id || undefined}>{skladba.nadpis}</h2>
          <div class="prose" set:html={uvodOddilu(skladbaHtml)} />
        </div>
        <div class="strom" role="group" aria-label="Složka dovednosti">
          <div class="strom-slozka"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h6l2 2h10v11H3z"></path></svg>slovni-hodnoceni/</div>
          <div class="strom-obsah">
            <div class="strom-soubor">
              <div class="strom-nazev">SKILL.md <span class="stitek stitek--cerveny">povinné</span></div>
              <div class="strom-casti">
                {castiSkladby.slice(0, 2).map((c) => <div class="strom-cast"><strong>{c.nazev}</strong><span set:html={c.text} /></div>)}
              </div>
            </div>
            {castiSkladby.length > 2 && (
              <div class="strom-soubor">
                <div class="strom-nazev">references/ <span class="stitek">volitelné</span></div>
                {castiSkladby.slice(2).map((c) => <div class="strom-cast"><strong>{c.nazev}</strong><span set:html={c.text} /></div>)}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {zWebu && (
    <section class="band band--white" aria-labelledby={zWebu.id || undefined}>
      <div class="wrap stack" style="gap: 32px">
        <div class="hlava">
          <h2 id={zWebu.id || undefined}>{zWebu.nadpis}</h2>
          <div class="prose" set:html={uvodOddilu(zWebuHtml)} />
        </div>
        <div class="cesty">
          {cesty.map((c, i) => (
            <div class="card">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="ikona" set:html={IKONY_CEST[i % IKONY_CEST.length]}></svg>
              <h3>{c.nazev}</h3>
              <p set:html={c.text} />
            </div>
          ))}
        </div>
        <a class="btn btn--primary" style="align-self: flex-start" href={url(katalog.href)}>{katalog.text} →</a>
      </div>
    </section>
  )}

  {instalace && (
    <section class="band band--sky" id={instalace.id || undefined} aria-labelledby={instalace.id ? `${instalace.id}-h` : undefined}>
      <div class="wrap stack" style="gap: 32px">
        <h2 id={instalace.id ? `${instalace.id}-h` : undefined}>{instalace.nadpis}</h2>
        <div class="zalozky-nastroju" role="tablist" aria-label="Chatovací aplikace" data-switch="instalace-panely">
          {nastroje.map((n, i) => <button type="button" role="tab" id={`${n.id}-tab`} aria-controls={n.id} aria-selected={i === 0 ? 'true' : 'false'} data-target={n.id}>{n.nazev}</button>)}
        </div>
        <div id="instalace-panely">
          {nastroje.map((n, i) => (
            <div class="panel" data-group-view={n.id} id={n.id} role="tabpanel" aria-labelledby={`${n.id}-tab`} hidden={i !== 0}>
              <ol class="kroky">
                {n.kroky.map((k, j) => <li><span class="kroky-cislo" aria-hidden="true">{j + 1}</span><span set:html={k} /></li>)}
              </ol>
              {n.podminky.length > 0 && (
                <div class="podminky">
                  <div class="podminky-titulek">Kdo ji může používat</div>
                  {n.podminky.map((p) => (
                    <p><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4M12 16h.01"></path></svg><span set:html={p} /></p>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {vlastni && (
    <section class="band band--white" aria-labelledby={vlastni.id || undefined}>
      <div class="wrap stack" style="gap: 32px">
        <div class="hlava">
          <h2 id={vlastni.id || undefined}>{vlastni.nadpis}</h2>
          <div class="prose" set:html={uvodOddilu(vlastniHtml)} />
        </div>
        <ol class="postup">
          {kroky.map((k, i) => (
            <li class:list={['postup-krok', { 'postup-krok--prvni': i === 0 }]}>
              <span class="postup-cislo" aria-hidden="true">{i + 1}</span>
              <h3>{k.nazev}</h3>
              <p set:html={k.perex} />
              {k.zbytek && (
                <details>
                  <summary>Podrobnosti</summary>
                  <div class="prose" set:html={k.zbytek} />
                </details>
              )}
            </li>
          ))}
        </ol>
        <div class="ukazky">
          {kroky.filter((k) => k.ukazka).map((k) => (
            <figure class="ukazka">
              <figcaption>{k.nazev}: ukázka</figcaption>
              <p set:html={k.ukazka} />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {vyzva && vyzva !== vlastni && (
    <section class="band band--sky" aria-labelledby={vyzva.id || undefined}>
      <div class="wrap vyzva">
        <div class="hlava">
          <h2 id={vyzva.id || undefined}>{vyzva.nadpis}</h2>
          <div class="prose" set:html={htmlOddilu(vyzva)} />
        </div>
        <div class="tlacitka">
          <a class="btn btn--primary" href={url(katalog.href)}>{katalog.text} →</a>
          <a class="btn btn--outline btn--bila" href={url('/o-webu/kontakt')}>Napsat nám</a>
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .video-uvod { margin-top: 56px; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .hlava { display: flex; flex-direction: column; gap: 14px; max-width: 64ch; }
  .tlacitka { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .perex :global(p) { font-size: 1.15rem; max-width: 52ch; }

  
  .podminky-titulek, .ukazka figcaption { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sky-ink); }

  .dva-sloupce { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 48px; align-items: start; }
  .strom { background: var(--panel); border: 1px solid var(--sky); border-radius: 12px; padding: 26px 28px; display: flex; flex-direction: column; gap: 8px; font-size: 0.95rem; }
  .strom-slozka, .strom-nazev { display: flex; gap: 10px; align-items: center; font-family: var(--fm); }
  .strom-slozka svg { color: var(--sky-ink); }
  .strom-obsah { margin-left: 28px; border-left: 2px solid var(--sky-light); padding: 10px 0 0 18px; display: flex; flex-direction: column; gap: 20px; }
  .strom-soubor { display: flex; flex-direction: column; gap: 10px; }
  .strom-casti { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
  .strom-cast { background: #f6fafc; border-radius: 8px; padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; font-size: 0.9rem; line-height: 1.55; }
  .strom-cast strong { font-size: 0.95rem; font-weight: 600; }
  .stitek { font-family: var(--fb); font-size: 0.75rem; padding: 2px 8px; border-radius: var(--pill); background: var(--sky-light); }
  .stitek--cerveny { background: var(--accent-soft); }

  .cesty { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 22px; }
  .cesty .ikona { color: var(--sky-ink); }
  .cesty .card h3 { font-size: 1.15rem; }
  .cesty .card p { font-size: 0.93rem; line-height: 1.6; }

  .zalozky-nastroju { display: flex; flex-wrap: wrap; gap: 10px; }
  .zalozky-nastroju button { min-height: 44px; padding: 0 20px; border-radius: var(--pill); font: inherit; font-size: 0.95rem; cursor: pointer; border: 1px solid var(--sky); background: var(--panel); color: var(--ink); }
  .zalozky-nastroju button[aria-selected='true'] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .panel { background: var(--panel); border: 1px solid var(--sky); border-radius: 12px; padding: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 36px; margin-top: -8px; }
  .panel[hidden] { display: none; }
  .kroky { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 18px; }
  .kroky li { display: flex; gap: 14px; align-items: flex-start; }
  .kroky-cislo { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--accent); color: var(--on-accent); display: inline-flex; align-items: center; justify-content: center; font-weight: 600; font-size: 14px; }
  .kroky li > span:last-child { padding-top: 3px; }
  .podminky { display: flex; flex-direction: column; gap: 14px; background: #f6fafc; border-radius: 10px; padding: 22px 24px; align-self: start; }
  .podminky p { margin: 0; display: flex; gap: 10px; align-items: flex-start; font-size: 0.93rem; }
  .podminky svg { flex: none; margin-top: 3px; color: var(--sky-ink); }

  .postup { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 22px; align-items: start; }
  .postup-krok { border: 1px solid var(--sky); border-radius: 9px; padding: 26px 28px; display: flex; flex-direction: column; gap: 12px; background: var(--panel); }
  .postup-krok--prvni { background: var(--accent-soft); }
  .postup-cislo { font-family: var(--fh); font-size: 1.75rem; font-weight: 700; color: var(--accent); line-height: 1; }
  .postup-krok h3 { font-size: 1.1rem; }
  .postup-krok > p { margin: 0; font-size: 0.93rem; line-height: 1.6; }
  .postup-krok details { font-size: 0.88rem; }
  .postup-krok summary { cursor: pointer; color: var(--accent-strong); font-weight: 600; min-height: 32px; display: flex; align-items: center; }
  .postup-krok details .prose :global(p), .postup-krok details .prose :global(li) { font-size: 0.88rem; line-height: 1.55; }
  .postup-krok details .prose :global(ul) { margin-top: 0.5em; }
  .ukazky { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 22px; }
  .ukazka { margin: 0; background: #f6fafc; border: 1px solid var(--sky); border-radius: 10px; padding: 22px 24px; display: flex; flex-direction: column; gap: 10px; }
  .ukazka p { margin: 0; font-family: var(--fm); font-size: 0.9rem; line-height: 1.6; }

  .vyzva { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
  .btn--bila { background: var(--panel); }
</style>
