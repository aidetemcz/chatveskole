---
// Projekty — co to je, kde je najdete, jak založit, co nahrávat (sablona: projekty-pruvodce). Návrh z Claude Design (20. 11. 2026).
// Texty jsou v content/stranky/funkce/projekty.md (oddíly podle ##), grafika stejná jako u stránek Dovednosti a Sady dovedností.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { rozdel, naOddily } from '../../lib/komponenty';
import { url } from '../../lib/url';

const stranka = (await getEntry('stranky', 'funkce/projekty'))!;
const d = stranka.data;
const { uvod, oddily } = naOddily(rozdel(stranka.rendered?.html ?? ''));
const htmlOddilu = (o?: { casti: { typ: string; html?: string }[] }) => (o?.casti ?? []).filter((x) => x.typ === 'html').map((x) => x.html ?? '').join('');
const perex = uvod.map((c) => (c.typ === 'html' ? c.html : '')).join('');
const najdi = (r: RegExp) => oddily.find((o) => r.test(o.nadpis));
const bezTagu = (s: string) => s.replace(/<[^>]+>/g, '').trim();
const uvodOddilu = (h: string) => h.split(/<(?:ul|ol|h3|table)[\s>]/)[0];
// položky „**Název** — text“ z prvního seznamu (ul i ol)
const polozky = (h: string) => [...(h.match(/<(ul|ol)>([\s\S]*?)<\/\1>/)?.[2] ?? '').matchAll(/<li>\s*<strong>([\s\S]*?)<\/strong>\s*[—–-]?\s*([\s\S]*?)<\/li>/g)]
  .map(([, n, t]) => ({ nazev: bezTagu(n).replace(/[.:]$/, ''), text: t.trim() }));
const bloky = (h: string) => h.split(/(?=<h3[\s>])/).filter((k) => /^\s*<h3/.test(k)).map((k) => {
  const m = k.match(/^\s*<h3[^>]*>([\s\S]*?)<\/h3>/)!;
  return { nazev: bezTagu(m[1]), html: k.slice(m.index! + m[0].length).trim() };
});
const predH3 = (h: string) => h.split(/<h3[\s>]/)[0];

const IKONY = [
  '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6M8 13h8M8 17h5"></path>',
  '<path d="M3 6h6l2 2h10v11H3z"></path>',
  '<path d="M21 12a8 8 0 0 1-11.8 7L4 20l1.1-4.6A8 8 0 1 1 21 12z"></path>',
];

const obsah = najdi(/Co je v projektu/i);
const obsahHtml = htmlOddilu(obsah);

// Tabulka: Nástroj | Jak se jmenují | Zdarma | Sdílení
const kde = najdi(/Kde projekty/i);
const kdeHtml = htmlOddilu(kde);
const hlavicka = [...(kdeHtml.match(/<thead>([\s\S]*?)<\/thead>/)?.[1] ?? '').matchAll(/<th[^>]*>([\s\S]*?)<\/th>/g)].map(([, t]) => bezTagu(t));
const radky = [...(kdeHtml.match(/<tbody>([\s\S]*?)<\/tbody>/)?.[1] ?? '').matchAll(/<tr>([\s\S]*?)<\/tr>/g)]
  .map(([, r]) => [...r.matchAll(/<td[^>]*>([\s\S]*?)<\/td>/g)].map(([, t]) => t.trim()))
  .map((b) => b.map((t, i) => (i > 1 ? t.charAt(0).toUpperCase() + t.slice(1) : t)));

const zalozit = najdi(/založit/i);
const kroky = polozky(htmlOddilu(zalozit));

const nahravat = najdi(/nahrávat/i);
const nahravatHtml = htmlOddilu(nahravat);
const hodiSeUvod = uvodOddilu(nahravatHtml);
const hodiSe = [...(predH3(nahravatHtml).match(/<ul>([\s\S]*?)<\/ul>/)?.[1] ?? '').matchAll(/<li>([\s\S]*?)<\/li>/g)].map(([, t]) => t.trim());
const pravidla = bloky(nahravatHtml)[0];
const pravidlaPolozky = pravidla ? polozky(pravidla.html) : [];

const format = najdi(/formátu/i);
const formatHtml = htmlOddilu(format);
const formatKarty = polozky(predH3(formatHtml));
const formatTip = bloky(formatHtml)[0];

// Sdílení: první odstavec vlevo, „**Pozor:**“ jako varování, „**Otázka?** text“ jako tip
const sdileni = najdi(/sdíleného asistenta/i);
const odstavce = [...htmlOddilu(sdileni).matchAll(/<p>([\s\S]*?)<\/p>/g)].map(([, t]) => t.trim());
const zvyrazneny = (p: string) => p.match(/^<strong>([\s\S]*?)<\/strong>\s*([\s\S]*)$/);
const sdileniText = odstavce.filter((p) => !zvyrazneny(p));
const sdileniBoxy = odstavce.map(zvyrazneny).filter((m): m is RegExpMatchArray => !!m)
  .map((m) => ({ nazev: bezTagu(m[1]).replace(/:$/, ''), text: m[2].charAt(0).toUpperCase() + m[2].slice(1) }));

const vyzva = najdi(/Propojte/i);
type Odkaz = { text: string; href: string };
const odkazy: Odkaz[] = (Array.isArray(d.odkazy) ? d.odkazy : []).filter((o: Odkaz) => o && o.href);
const datum = d.aktualizovano ? d.aktualizovano.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'numeric', year: 'numeric' }) : null;
---
<Base title={d.title} description={d.popis ?? undefined}>
  <div class="band band--white">
    <div class="wrap hero">
      <div class="page-head">
        <div class="zahlavi">
          <Crumbs items={[{ title: 'Funkce' }, { title: d.title }]} />
          {datum && <span class="draft">Aktualizováno {datum}</span>}
        </div>
        <h1>{d.title}</h1>
        <div class="lede perex" set:html={perex} />
        <div class="tlacitka">
          {zalozit && <a class="btn btn--primary" href={`#${zalozit.id}`}>{zalozit.nadpis} ↓</a>}
          <a class="btn btn--outline" href={url('/skills')}>Katalog dovedností</a>
        </div>
      </div>
    </div>
  </div>

  {obsah && (
    <section class="band band--sky" aria-labelledby={obsah.id || undefined}>
      <div class="wrap stack" style="gap: 32px">
        <div class="hlava">
          <h2 id={obsah.id || undefined}>{obsah.nadpis}</h2>
          <div class="prose" set:html={uvodOddilu(obsahHtml)} />
        </div>
        <div class="karty">
          {polozky(obsahHtml).map((c, i) => (
            <div class="card">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="ikona" set:html={IKONY[i % IKONY.length]}></svg>
              <h3>{c.nazev}</h3>
              <p set:html={c.text} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {kde && (
    <section class="band band--white" aria-labelledby={kde.id || undefined}>
      <div class="wrap stack" style="gap: 32px">
        <div class="hlava">
          <h2 id={kde.id || undefined}>{kde.nadpis}</h2>
          <div class="prose" set:html={uvodOddilu(kdeHtml)} />
        </div>
        <div class="tabulka" role="table" aria-label={kde.nadpis}>
          <div class="radek radek--hlavicka" role="row">
            <div role="columnheader">{hlavicka[0]}</div>
            {hlavicka.slice(2).map((h) => <div role="columnheader">{h}</div>)}
          </div>
          {radky.map((r) => (
            <div class="radek" role="row">
              <div class="radek-nazev" role="rowheader"><strong>{bezTagu(r[0])}</strong><span set:html={r[1]} /></div>
              {r.slice(2).map((t, i) => <div role="cell"><span class="popisek">{hlavicka[i + 2]}: </span><span set:html={t} /></div>)}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {zalozit && (
    <section class="band band--sky" id={zalozit.id || undefined} aria-labelledby={zalozit.id ? `${zalozit.id}-h` : undefined}>
      <div class="wrap stack" style="gap: 32px">
        <h2 id={zalozit.id ? `${zalozit.id}-h` : undefined}>{zalozit.nadpis}</h2>
        <ol class="postup">
          {kroky.map((k, i) => (
            <li class:list={['postup-krok', { 'postup-krok--prvni': i === 0 }]}>
              <span class="postup-cislo" aria-hidden="true">{i + 1}</span>
              <h3>{k.nazev}</h3>
              <p set:html={k.text} />
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {nahravat && (
    <section class="band band--white" aria-labelledby={nahravat.id || undefined}>
      <div class="wrap dva-sloupce">
        <div class="stack" style="gap: 20px">
          <h2 id={nahravat.id || undefined}>{nahravat.nadpis}</h2>
          <div class="titulek">{bezTagu(hodiSeUvod).replace(/:$/, '')}</div>
          <ul class="cipy">{hodiSe.map((t) => <li class="cip" set:html={t} />)}</ul>
        </div>
        {pravidla && (
          <div class="pravidla">
            <div class="titulek titulek--cerveny">{pravidla.nazev}</div>
            {pravidlaPolozky.map((p) => (
              <div class="pravidlo">
                <strong>{p.nazev}</strong>
                <span set:html={p.text} />
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {format && (
    <section class="band band--sky" aria-labelledby={format.id || undefined}>
      <div class="wrap stack" style="gap: 32px">
        <div class="hlava">
          <h2 id={format.id || undefined}>{format.nadpis}</h2>
          <div class="prose" set:html={uvodOddilu(formatHtml)} />
        </div>
        <div class="karty">
          {formatKarty.map((c) => (
            <div class="card">
              <h3>{c.nazev}</h3>
              <p set:html={c.text} />
            </div>
          ))}
        </div>
        {formatTip && (
          <div class="tip">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4M12 16h.01"></path></svg>
            <div class="stack" style="gap: 4px">
              <strong>{formatTip.nazev}</strong>
              <div class="tip-text" set:html={formatTip.html} />
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  {sdileni && (
    <section class="band band--white" aria-labelledby={sdileni.id || undefined}>
      <div class="wrap dva-sloupce">
        <div class="hlava">
          <h2 id={sdileni.id || undefined}>{sdileni.nadpis}</h2>
          <div class="prose">{sdileniText.map((p) => <p set:html={p} />)}</div>
        </div>
        <div class="stack" style="gap: 16px">
          {sdileniBoxy.map((b, i) => i === 0 ? (
            <div class="pozor">
              <div class="titulek titulek--cerveny">{b.nazev}</div>
              <p set:html={b.text} />
            </div>
          ) : (
            <div class="podminky">
              <strong>{b.nazev}</strong>
              <p set:html={b.text} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {vyzva && (
    <section class="band band--sky" aria-labelledby={vyzva.id || undefined}>
      <div class="wrap vyzva">
        <div class="hlava">
          <h2 id={vyzva.id || undefined}>{vyzva.nadpis}</h2>
          <div class="prose" set:html={htmlOddilu(vyzva)} />
        </div>
        <div class="tlacitka">
          {odkazy.map((o, i) => <a class:list={['btn', i === 0 ? 'btn--primary' : 'btn--outline btn--bila']} href={url(o.href)}>{o.text}{i === 0 && ' →'}</a>)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .hlava { display: flex; flex-direction: column; gap: 14px; max-width: 64ch; }
  .tlacitka { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .perex :global(p) { font-size: 1.15rem; }
  .perex :global(p + p) { margin-top: 0.6em; }
  .dva-sloupce { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 48px; align-items: start; }
  .titulek { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sky-ink); }
  .titulek--cerveny { color: var(--accent-strong); }

  .karty { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 22px; }
  .karty .ikona { color: var(--sky-ink); }
  .karty .card h3 { font-size: 1.15rem; }
  .karty .card p { font-size: 0.93rem; line-height: 1.6; }

  .tabulka { border: 1px solid var(--sky); border-radius: 9px; overflow: hidden; background: var(--panel); }
  .radek { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .radek + .radek { border-top: 1px solid #d5e5eb; }
  .radek > div { padding: 22px 26px; }
  .radek--hlavicka { background: var(--sky-light); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sky-ink); }
  .radek--hlavicka > div { padding: 14px 26px; }
  .radek-nazev { background: #f6fafc; display: flex; flex-direction: column; }
  .radek-nazev strong { font-family: var(--fh); font-size: 1.1rem; }
  .radek-nazev span { font-size: 0.88rem; }
  .popisek { display: none; font-weight: 600; }
  @media (max-width: 700px) {
    .radek { grid-template-columns: 1fr; }
    .radek--hlavicka { display: none; }
    .radek > div:not(.radek-nazev) { padding-top: 6px; padding-bottom: 6px; }
    .radek > div:last-child { padding-bottom: 20px; }
    .radek-nazev { margin-bottom: 8px; }
    .popisek { display: inline; }
  }

  .postup { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 22px; }
  .postup-krok { border: 1px solid var(--sky); border-radius: 9px; padding: 26px 28px; display: flex; flex-direction: column; gap: 12px; background: var(--panel); }
  .postup-krok--prvni { background: var(--accent-soft); }
  .postup-cislo { font-family: var(--fh); font-size: 1.75rem; font-weight: 700; color: var(--accent); line-height: 1; }
  .postup-krok h3 { font-size: 1.1rem; }
  .postup-krok > p { margin: 0; font-size: 0.93rem; line-height: 1.6; }

  .cipy { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .cip { font-size: 0.88rem; padding: 5px 12px; border-radius: var(--pill); background: #f6fafc; border: 1px solid #d5e5eb; }
  .pravidla, .pozor { background: var(--accent-soft); border-radius: 12px; padding: 30px 32px; display: flex; flex-direction: column; gap: 18px; }
  .pozor { padding: 26px 28px; gap: 10px; }
  .pozor p { margin: 0; }
  .pravidlo { background: var(--panel); border-radius: 9px; padding: 18px 20px; display: flex; flex-direction: column; gap: 4px; }
  .pravidlo strong { font-weight: 600; }
  .pravidlo span { font-size: 0.95rem; }
  @media (max-width: 640px) { .pravidla { padding: 24px 20px; } }

  .tip { background: var(--panel); border-radius: 9px; padding: 22px 26px; display: flex; gap: 14px; align-items: flex-start; }
  .tip svg { flex: none; margin-top: 2px; color: var(--sky-ink); }
  .tip strong { font-weight: 600; }
  .tip-text :global(p) { margin: 0; font-size: 0.95rem; }

  .podminky { display: flex; flex-direction: column; gap: 6px; background: #f6fafc; border: 1px solid var(--sky); border-radius: 9px; padding: 22px 26px; }
  .podminky strong { font-weight: 600; }
  .podminky p { margin: 0; font-size: 0.95rem; }

  .vyzva { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
  .btn--bila { background: var(--panel); }
</style>
