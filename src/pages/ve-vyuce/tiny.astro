---
// AI aplikace Tiny — jak funguje, jedenáct Tinybotů, bezpečnost, co dalšího nabízí (sablona: tiny-pruvodce).
// Texty jsou v content/stranky/ve-vyuce/tiny.md (oddíly podle ##), grafika stejná jako u stránky Projekty (src/pages/funkce/projekty.astro).
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { rozdel, naOddily } from '../../lib/komponenty';
import { url } from '../../lib/url';

const stranka = (await getEntry('stranky', 've-vyuce/tiny'))!;
const d = stranka.data;
const { uvod, oddily } = naOddily(rozdel(stranka.rendered?.html ?? ''));
const htmlOddilu = (o?: { casti: { typ: string; html?: string }[] }) => (o?.casti ?? []).filter((x) => x.typ === 'html').map((x) => x.html ?? '').join('');
const uvodHtml = uvod.map((c) => (c.typ === 'html' ? c.html : '')).join('');
const najdi = (r: RegExp) => oddily.find((o) => r.test(o.nadpis));
const bezTagu = (s: string) => s.replace(/<[^>]+>/g, '').trim();
const velke = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
// tlačítko (komponenta „tlačítko“) → { text, href }; v perexu i v oddílu se vykreslí zvlášť
const RE_TLACITKO = /<p class="tlacitko-odstavec">\s*<a [^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>\s*<\/p>/;
const tlacitkoZ = (h: string) => { const m = h.match(RE_TLACITKO); return m ? { href: m[1], text: bezTagu(m[2]) } : null; };
const bezTlacitka = (h: string) => h.replace(RE_TLACITKO, '');
const uvodOddilu = (h: string) => h.split(/<(?:ul|ol|h3|table)[\s>]/)[0].replace(/<p>\s*<img [^>]*>\s*<\/p>/, '');
// položky „**Název** — text“ z prvního seznamu (ul i ol)
const polozky = (h: string) => [...(h.match(/<(ul|ol)>([\s\S]*?)<\/\1>/)?.[2] ?? '').matchAll(/<li>\s*<strong>([\s\S]*?)<\/strong>\s*[—–-]?\s*([\s\S]*?)<\/li>/g)]
  .map(([, n, t]) => ({ nazev: bezTagu(n).replace(/[.:]$/, ''), text: t.trim() }));

const vyzkouset = tlacitkoZ(uvodHtml);
const perex = bezTlacitka(uvodHtml);

const jak = najdi(/Jak Tiny funguje/i);
const kroky = polozky(htmlOddilu(jak));

// Tinyboti: velký obrázek (diagram) a pod ním sloupec pro každou úroveň; tabulka Kognitivní proces | Tinybot | Popis | Metodika | Vyzkoušet
const boti = najdi(/chatbotů podle/i);
const botiHtml = htmlOddilu(boti);
const diagram = botiHtml.match(/<img [^>]*>/)?.[0] ?? '';
// sloupce Metodika a Vyzkoušet (nepovinné): odkaz v buňce → tlačítko u Tinybota
const odkazZ = (t?: string) => t?.match(/<a href="([^"]+)"/)?.[1] ?? '';
const skupiny: { proces: string; boti: { nazev: string; popis: string; metodika: string; vyzkouset: string }[] }[] = [];
for (const [, r] of (botiHtml.match(/<tbody>([\s\S]*?)<\/tbody>/)?.[1] ?? '').matchAll(/<tr>([\s\S]*?)<\/tr>/g)) {
  const [proces, nazev, popis, metodika, vyzkouset] = [...r.matchAll(/<td[^>]*>([\s\S]*?)<\/td>/g)].map(([, t]) => t.trim());
  if (bezTagu(proces ?? '') || !skupiny.length) skupiny.push({ proces: bezTagu(proces ?? ''), boti: [] });
  skupiny.at(-1)!.boti.push({ nazev: nazev ?? '', popis: popis ?? '', metodika: odkazZ(metodika), vyzkouset: odkazZ(vyzkouset) });
}
const navody = tlacitkoZ(botiHtml);

const bezpecnost = najdi(/Bezpečnost/i);
const bezpecnostHtml = htmlOddilu(bezpecnost);
const zasady = polozky(bezpecnostHtml);
const IKONY = [
  '<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"></path>',
  '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6M8 13h8M8 17h5"></path>',
  '<circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path>',
];

const dalsi = najdi(/Co dalšího/i);
type Odkaz = { text: string; href: string };
const tlacitko = d.tlacitko && typeof d.tlacitko === 'object' && d.tlacitko.href ? (d.tlacitko as Odkaz) : null;
const odkazy: Odkaz[] = [tlacitko, ...(Array.isArray(d.odkazy) ? d.odkazy : [])].filter((o): o is Odkaz => !!o && !!o.href);
const datum = d.aktualizovano ? d.aktualizovano.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'numeric', year: 'numeric' }) : null;
---
<Base title={d.title} description={d.popis ?? undefined}>
  <div class="band band--white">
    <div class="wrap hero">
      <div class="page-head">
        <div class="zahlavi">
          <Crumbs items={[{ title: 'Chatboti ve výuce' }, { title: d.title }]} />
          {datum && <span class="draft">Aktualizováno {datum}</span>}
        </div>
        <h1>{d.title}</h1>
        <div class="lede perex" set:html={perex} />
        <div class="tlacitka">
          {vyzkouset && <a class="btn btn--primary" href={vyzkouset.href}>{vyzkouset.text} →</a>}
          {boti && <a class="btn btn--outline" href={`#${boti.id}`}>Tinyboti ↓</a>}
        </div>
      </div>
      {jak && (
        <div class="jak stack" style="gap: 30px">
          <h2 id={jak.id || undefined}>{jak.nadpis}</h2>
          <ol class="postup">
            {kroky.map((k, i) => (
              <li class:list={['postup-krok', { 'postup-krok--prvni': i === 0 }]}>
                <span class="postup-cislo" aria-hidden="true">{i + 1}</span>
                <h3>{k.nazev}</h3>
                <p set:html={k.text} />
              </li>
            ))}
          </ol>
        </div>
      )}
    </div>
  </div>

  {boti && (
    <section class="band band--sky" id={boti.id || undefined} aria-labelledby={boti.id ? `${boti.id}-h` : undefined}>
      <div class="wrap stack" style="gap: 32px">
        <div class="hlava">
          <h2 id={boti.id ? `${boti.id}-h` : undefined}>{boti.nadpis}</h2>
          <div class="prose" set:html={uvodOddilu(botiHtml)} />
        </div>
        {diagram && <div class="diagram" set:html={diagram} />}
        <div class="urovne">
          {skupiny.map((s) => (
            <section class="uroven" aria-label={s.proces}>
              <h3 class="uroven-nazev">{s.proces}</h3>
              <ul class="seznam-botu">
                {s.boti.map((b) => (
                  <li>
                    <strong set:html={b.nazev} />
                    <span set:html={b.popis} />
                    {(b.metodika || b.vyzkouset) && (
                      <span class="bot-odkazy">
                        {b.metodika && <a href={b.metodika}>Metodika</a>}
                        {b.vyzkouset && <a href={b.vyzkouset}>Vyzkoušet</a>}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        {navody && <div><a class="btn btn--outline btn--bila" href={navody.href}>{navody.text} →</a></div>}
      </div>
    </section>
  )}

  {bezpecnost && (
    <section class="band band--white" aria-labelledby={bezpecnost.id || undefined}>
      <div class="wrap stack" style="gap: 32px">
        <h2 id={bezpecnost.id || undefined}>{bezpecnost.nadpis}</h2>
        <div class="karty">
          {zasady.map((z, i) => (
            <div class:list={['card', { 'card--ruzova': i === zasady.length - 1 }]}>
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="ikona" set:html={IKONY[i % IKONY.length]}></svg>
              <h3>{z.nazev}</h3>
              <p set:html={velke(z.text)} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {dalsi && (
    <section class="band band--sky" aria-labelledby={dalsi.id || undefined}>
      <div class="wrap vyzva">
        <div class="hlava">
          <h2 id={dalsi.id || undefined}>{dalsi.nadpis}</h2>
          <div class="prose" set:html={htmlOddilu(dalsi)} />
        </div>
        <div class="tlacitka">
          {odkazy.map((o, i) => <a class:list={['btn', i === 0 ? 'btn--primary' : 'btn--outline btn--bila']} href={url(o.href)}>{o.text}{i === 0 && ' →'}</a>)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .jak { margin-top: 64px; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .hlava { display: flex; flex-direction: column; gap: 14px; max-width: var(--dve-tretiny); }
  .tlacitka { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .perex :global(p) { font-size: 1.15rem; }
  .perex :global(p + p) { margin-top: 0.6em; }

  .postup { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 22px; }
  .postup-krok { border: 1px solid var(--sky); border-radius: 9px; padding: 26px 28px; display: flex; flex-direction: column; gap: 12px; background: var(--panel); }
  .postup-krok--prvni { background: var(--accent-soft); }
  .postup-cislo { font-family: var(--fh); font-size: 1.75rem; font-weight: 700; color: var(--accent); line-height: 1; }
  .postup-krok h3 { font-size: 1.1rem; }
  .postup-krok > p { margin: 0; font-size: 0.93rem; line-height: 1.6; }

  .diagram { background: var(--panel); border: 1px solid var(--sky); border-radius: 9px; padding: 32px; }
  .diagram :global(img) { display: block; width: 100%; max-width: 980px; height: auto; margin: 0 auto; }
  @media (max-width: 640px) { .diagram { padding: 16px; } }

  .urovne { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 16px; align-items: stretch; }
  .uroven { background: var(--panel); border: 1px solid var(--sky); border-radius: 9px; overflow: hidden; display: flex; flex-direction: column; }
  .uroven-nazev { margin: 0; background: var(--sky-light); padding: 14px 18px; font-size: 1.05rem; }
  .seznam-botu { margin: 0; padding: 18px; list-style: none; display: flex; flex-direction: column; gap: 18px; font-size: 0.93rem; line-height: 1.55; }
  .seznam-botu li { display: flex; flex-direction: column; gap: 4px; }
  .seznam-botu li + li { border-top: 1px solid var(--line); padding-top: 18px; }
  .seznam-botu strong { font-weight: 600; }
  .bot-odkazy { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 4px; font-size: 0.88rem; font-weight: 600; }

  .karty { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 22px; }
  .karty .ikona { color: var(--sky-ink); }
  .karty .card h3 { font-size: 1.15rem; }
  .karty .card p { font-size: 0.93rem; line-height: 1.6; }
  .card--ruzova { background: var(--accent-soft); border-color: var(--accent-soft); }
  .card--ruzova .ikona { color: var(--accent-strong); }

  .vyzva { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
  .btn--bila { background: var(--panel); }
  .stack > .btn { align-self: flex-start; }
</style>
