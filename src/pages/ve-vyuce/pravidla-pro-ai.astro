---
// Tvorba pravidel pro využívání AI (sablona: pravidla-pruvodce). Návrh z Claude Design (20. 11. 2026).
// Texty jsou v content/stranky/ve-vyuce/pravidla-pro-ai.md (oddíly podle ##, části podle ###), grafika stejná jako u stránky Projekty.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { rozdel, naOddily } from '../../lib/komponenty';
import { navigace } from '../../lib/data';
import { url } from '../../lib/url';

const stranka = (await getEntry('stranky', 've-vyuce/pravidla-pro-ai'))!;
const d = stranka.data;
const { uvod, oddily } = naOddily(rozdel(stranka.rendered?.html ?? ''));
const htmlOddilu = (o?: { casti: { typ: string; html?: string }[] }) => (o?.casti ?? []).filter((x) => x.typ === 'html').map((x) => x.html ?? '').join('');
const perex = uvod.map((c) => (c.typ === 'html' ? c.html : '')).join('');
const najdi = (r: RegExp) => oddily.find((o) => r.test(o.nadpis));
const bezTagu = (s: string) => s.replace(/<[^>]+>/g, '').trim();
const predH3 = (h: string) => h.split(/<h3[\s>]/)[0];
const uvodOddilu = (h: string) => predH3(h).split(/<(?:ul|ol|table)[\s>]/)[0];
const polozky = (h: string) => [...(h.match(/<(ul|ol)>([\s\S]*?)<\/\1>/)?.[2] ?? '').matchAll(/<li>\s*<strong>([\s\S]*?)<\/strong>\s*[—–-]?\s*([\s\S]*?)<\/li>/g)]
  .map(([, n, t]) => ({ nazev: bezTagu(n).replace(/[.:]$/, ''), text: t.trim() }));
const seznam = (h: string) => [...(h.match(/<(ul|ol)>([\s\S]*?)<\/\1>/)?.[2] ?? '').matchAll(/<li>([\s\S]*?)<\/li>/g)].map(([, t]) => t.trim());
const bloky = (h: string) => h.split(/(?=<h3[\s>])/).filter((k) => /^\s*<h3/.test(k)).map((k) => {
  const m = k.match(/^\s*<h3[^>]*>([\s\S]*?)<\/h3>/)!;
  return { nazev: bezTagu(m[1]), html: k.slice(m.index! + m[0].length).trim() };
});
const najdiBlok = (b: { nazev: string; html: string }[], r: RegExp) => b.find((x) => r.test(x.nazev));
// odkaz v samostatném odstavci → { text, href }; zbytek bez něj
const odkazOdstavec = (h: string) => {
  const m = h.match(/<p>\s*<a href="([^"]+)"[^>]*>([\s\S]*?)<\/a>\s*<\/p>/);
  return { odkaz: m ? { href: m[1], text: bezTagu(m[2]) } : null, zbytek: m ? h.replace(m[0], '') : h };
};

const seZaky = najdi(/společně se žáky/i);
const vedeni = najdi(/připraví vedení/i);

// Se žáky: lekce (obrázek, text, odkaz) a workshop (tabulka)
const seZakyHtml = htmlOddilu(seZaky);
const seZakyBloky = bloky(seZakyHtml);
const lekce = najdiBlok(seZakyBloky, /lekcí/i);
const lekceImg = lekce?.html.match(/<img[^>]*>/)?.[0] ?? '';
const lekceSrc = lekceImg.match(/src="([^"]+)"/)?.[1] ?? '';
const lekceAlt = lekceImg.match(/alt="([^"]*)"/)?.[1] ?? '';
const lekceCast = odkazOdstavec((lekce?.html ?? '').replace(/<p>\s*<img[^>]*>\s*<\/p>/, ''));
const lekceMinuty = bezTagu(lekceCast.zbytek).match(/(\d+)\s*minut/)?.[1];
const workshop = najdiBlok(seZakyBloky, /Workshop/i);
const workshopUvod = (workshop?.html ?? '').split(/<table[\s>]/)[0];
const workshopRadky = [...((workshop?.html ?? '').match(/<tbody>([\s\S]*?)<\/tbody>/)?.[1] ?? '').matchAll(/<tr>([\s\S]*?)<\/tr>/g)]
  .map(([, r]) => [...r.matchAll(/<td[^>]*>([\s\S]*?)<\/td>/g)].map(([, t]) => t.trim()))
  .map((b) => ({ nazev: bezTagu(b[0] ?? ''), cas: bezTagu(b[1] ?? ''), text: b[2] ?? '' }));
const workshopMinut = workshopRadky.reduce((s, r) => s + (parseInt(r.cas, 10) || 0), 0);
// časová osa: od–do v minutách
let start = 0;
const osa = workshopRadky.map((r) => { const od = start; start += parseInt(r.cas, 10) || 0; return { ...r, od, do: start }; });
const hodiny = (m: number) => (m >= 90 ? `asi ${Math.round(m / 60)} ${Math.round(m / 60) < 5 ? 'hodiny' : 'hodin'} (${m} minut)` : `${m} minut`);

// Formulace a zavádění (### v oddílu Pravidla společně se žáky): prostý text bez boxů
const formulace = najdiBlok(seZakyBloky, /formulací/i);
const zavadeni = najdiBlok(seZakyBloky, /Zavádění/i);

// Vedení: dovednost, postup, obsah
const vedeniHtml = htmlOddilu(vedeni);
const vedeniBloky = bloky(vedeniHtml);
const vedeniUvod = odkazOdstavec(predH3(vedeniHtml));
const postup = najdiBlok(vedeniBloky, /Postup/i);
const obsah = najdiBlok(vedeniBloky, /obsahovat/i);

// Úrovně
const urovne = najdi(/Úrovně/i);
const urovneHtml = htmlOddilu(urovne);
const urovnePolozky = polozky(urovneHtml);

// Doporučení a zákonní zástupci: dvě karty
const dalsi = najdi(/Doporučení a zákonní zástupci/i);
const dalsiKarty = bloky(htmlOddilu(dalsi)).map((b, i) => ({ ...b, ...odkazOdstavec(b.html), stitek: ['Doporučení NPI', 'Komunikace s rodiči'][i] ?? '' }));

const vyzva = najdi(/Pusťte se/i);
type Odkaz = { text: string; href: string };
const odkazy: Odkaz[] = (Array.isArray(d.odkazy) ? d.odkazy : []).filter((o: Odkaz) => o && o.href);
const skupina = navigace.menu.find((g) => g.items.some((i) => i.href === '/' + stranka.id));
const datum = d.aktualizovano ? d.aktualizovano.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'numeric', year: 'numeric' }) : null;
---
<Base title={d.title} description={d.popis ?? undefined}>
  <div class="band band--white">
    <div class="wrap hero">
      <div class="page-head">
        <div class="zahlavi">
          <Crumbs items={[...(skupina ? [{ title: skupina.title }] : []), { title: d.title }]} />
          {datum && <span class="draft">Aktualizováno {datum}</span>}
        </div>
        <h1>{d.title}</h1>
        <div class="lede perex" set:html={perex} />
      </div>
    </div>
  </div>

  {seZaky && (
    <section class="band band--sky" id={seZaky.id || undefined} aria-labelledby={seZaky.id ? `${seZaky.id}-h` : undefined}>
      <div class="wrap stack" style="gap: 32px">
        <div class="hlava">
          <h2 id={seZaky.id ? `${seZaky.id}-h` : undefined}>{seZaky.nadpis}</h2>
          <div class="prose" set:html={uvodOddilu(seZakyHtml)} />
        </div>

        {lekce && (
          <div class="card lekce">
            {lekceSrc && <img src={lekceSrc} alt={lekceAlt} loading="lazy" />}
            <div class="stack" style="gap: 14px">
              <h3>{lekce.nazev}</h3>
              {lekceMinuty && <span class="stitek">{lekceMinuty} minut</span>}
              <div class="lekce-text" set:html={lekceCast.zbytek} />
              {lekceCast.odkaz && <a class="btn btn--outline btn--small" style="align-self: flex-start" href={lekceCast.odkaz.href}>{lekceCast.odkaz.text}</a>}
            </div>
          </div>
        )}

      </div>
    </section>
  )}

  {workshop && (
    <section class="band band--white" aria-labelledby="workshop-h">
      <div class="wrap stack" style="gap: 32px">
        <div class="hlava">
          <div class="cast-hlava">
            <h2 id="workshop-h">{workshop.nazev}</h2>
            {workshopMinut > 0 && <span class="stitek">{hodiny(workshopMinut)}</span>}
          </div>
          <div class="prose" set:html={workshopUvod} />
        </div>
        <ol class="osa">
          {osa.map((r) => (
            <li>
              <span class="osa-cas">{r.od}.–{r.do}. minuta</span>
              <span class="osa-bod" aria-hidden="true"></span>
              <div class="osa-obsah">
                <strong>{r.nazev}</strong>
                <p set:html={r.text} />
              </div>
            </li>
          ))}
        </ol>

        {(formulace || zavadeni) && (
          <div class="dva-sloupce">
            {formulace && (
              <div class="cast">
                <h3>{formulace.nazev}</h3>
                <div class="prose" set:html={formulace.html} />
              </div>
            )}
            {zavadeni && (
              <div class="cast">
                <h3>{zavadeni.nazev}</h3>
                <div class="prose" set:html={zavadeni.html} />
              </div>
            )}
          </div>
        )}
      </div>
    </section>
  )}

  {vedeni && (
    <section class="band band--sky" id={vedeni.id || undefined} aria-labelledby={vedeni.id ? `${vedeni.id}-h` : undefined}>
      <div class="wrap stack" style="gap: 48px">
        <div class="hlava">
          <h2 id={vedeni.id ? `${vedeni.id}-h` : undefined}>{vedeni.nadpis}</h2>
          <div class="prose" set:html={vedeniUvod.zbytek} />
          {vedeniUvod.odkaz && <div class="tlacitka"><a class="btn btn--outline btn--bila" href={vedeniUvod.odkaz.href}>{vedeniUvod.odkaz.text} →</a></div>}
        </div>
      </div>
    </section>
  )}

  {vedeni && (postup || obsah) && (
    <section class="band band--white" aria-label="Postup a obsah pravidel">
      <div class="wrap stack" style="gap: 48px">
        {postup && (
          <div class="stack" style="gap: 18px">
            <h3 class="h3-oddil">{postup.nazev}</h3>
            <ol class="postup">
              {polozky(postup.html).map((k, i) => (
                <li class="postup-krok">
                  <span class="postup-cislo" aria-hidden="true">{i + 1}</span>
                  <strong class="postup-nazev">{k.nazev}</strong>
                  <p set:html={k.text} />
                </li>
              ))}
            </ol>
          </div>
        )}

        {obsah && (
          <div class="stack" style="gap: 18px">
            <h3 class="h3-oddil">{obsah.nazev}</h3>
            <ul class="kontrolni">
              {seznam(obsah.html).map((t) => (
                <li set:html={t} />
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  {urovne && (
    <section class="band band--sky" aria-labelledby={urovne.id || undefined}>
      <div class="wrap stack" style="gap: 32px">
        <div class="hlava">
          <h2 id={urovne.id || undefined}>{urovne.nadpis}</h2>
          <div class="prose" set:html={uvodOddilu(urovneHtml)} />
        </div>
        <ol class="urovne">
          {urovnePolozky.map((u, i) => (
            <li class="card">
              <div class="meridlo" aria-hidden="true">{[0, 1, 2, 3].map((j) => <span class:list={{ plne: j < i }} />)}</div>
              <span class="uroven">Úroveň {i + 1}</span>
              <h3>{u.nazev}</h3>
              <p set:html={u.text} />
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {dalsi && (
    <section class="band band--white" aria-labelledby={dalsi.id || undefined}>
      <div class="wrap stack" style="gap: 32px">
        <h2 id={dalsi.id || undefined} class="sr-only">{dalsi.nadpis}</h2>
        <div class="karty-2">
          {dalsiKarty.map((k) => (
            <div class="card">
              <div class="titulek">{k.stitek}</div>
              <h3>{k.nazev}</h3>
              <div class="karta-text" set:html={k.zbytek} />
              {k.odkaz && <a class="more" href={k.odkaz.href} style="margin-top: auto">{k.odkaz.text} →</a>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {vyzva && (
    <section class="band band--sky" aria-labelledby={vyzva.id || undefined}>
      <div class="wrap vyzva">
        <div class="hlava">
          <h2 id={vyzva.id || undefined}>{vyzva.nadpis}</h2>
          <div class="prose" set:html={htmlOddilu(vyzva)} />
        </div>
        <div class="tlacitka">
          {odkazy.map((o, i) => <a class:list={['btn', i === 0 ? 'btn--primary' : 'btn--outline btn--bila']} href={url(o.href)}>{o.text}{i === 0 && ' →'}</a>)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .hlava { display: flex; flex-direction: column; gap: 14px; max-width: var(--dve-tretiny); }
  .tlacitka { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .perex :global(p) { font-size: 1.15rem; }
  .perex :global(p + p) { margin-top: 0.6em; }
  .dva-sloupce { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 48px; align-items: start; }
  .titulek { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sky-ink); }
  .titulek--cerveny { color: var(--accent-strong); }
  .stitek { align-self: flex-start; font-family: var(--fb); font-size: 0.75rem; padding: 2px 8px; border-radius: var(--pill); background: var(--sky-light); }
  .postup-cislo { font-family: var(--fh); font-size: 1.75rem; font-weight: 700; color: var(--accent); line-height: 1; }
  .h3-oddil { font-size: 1.35rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }


  .lekce { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 36px; align-items: center; }
  .lekce img { display: block; width: 100%; border-radius: 8px; border: 1px solid var(--line); }
  @media (max-width: 760px) { .lekce { grid-template-columns: 1fr; } .lekce img { max-width: 420px; } }
  .lekce h3 { font-size: 1.25rem; }
  .lekce-text :global(p) { margin: 0; font-size: 0.95rem; line-height: 1.6; }
  .workshop-uvod :global(p) { margin: 0; max-width: var(--dve-tretiny); }
  .cast { display: flex; flex-direction: column; gap: 16px; margin-top: 24px; }
  .cast h3 { font-size: 1.35rem; }
  .cast-hlava { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .cast-hlava .stitek { align-self: center; }
  .band--sky .cast .stitek { background: var(--panel); }
  .osa { margin: 8px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; max-width: 900px; }
  .osa li { display: grid; grid-template-columns: 150px 24px minmax(0, 1fr); gap: 0 18px; position: relative; padding-bottom: 32px; }
  .osa li:last-child { padding-bottom: 0; }
  .osa li::before { content: ""; position: absolute; left: calc(150px + 18px + 11px); top: 18px; bottom: -2px; width: 2px; background: var(--sky); }
  .osa li:last-child::before { display: none; }
  .osa-cas { font-size: 0.85rem; font-weight: 600; color: var(--sky-ink); text-align: right; padding-top: 2px; }
  .osa-bod { width: 16px; height: 16px; border-radius: 50%; background: var(--accent); border: 3px solid var(--accent-soft); margin: 2px 0 0 1px; position: relative; z-index: 1; }
  .osa-obsah { display: flex; flex-direction: column; gap: 6px; }
  .osa-obsah strong { font-family: var(--fh); font-weight: 600; font-size: 1.1rem; line-height: 1.3; }
  .osa-obsah p { margin: 0; font-size: 0.95rem; line-height: 1.6; }
  @media (max-width: 640px) {
    .osa li { grid-template-columns: 24px minmax(0, 1fr); }
    .osa-cas { grid-column: 2; grid-row: 1; text-align: left; padding: 0 0 4px; }
    .osa-bod { grid-column: 1; grid-row: 1 / span 2; }
    .osa-obsah { grid-column: 2; }
    .osa li::before { left: 11px; }
  }
  .dva-sloupce .cast { margin-top: 32px; }


  .card :global(p) { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--ink); }


  .postup { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 22px; }
  .postup-krok { border: 1px solid var(--sky); border-radius: 9px; padding: 22px 24px; display: flex; flex-direction: column; gap: 10px; background: var(--panel); }
  .postup-nazev { font-family: var(--fh); font-size: 1.05rem; line-height: 1.3; }
  .postup-krok p { margin: 0; font-size: 0.9rem; line-height: 1.55; }

  .kontrolni { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 12px; }
  .kontrolni li { background: #f6fafc; border-radius: 9px; padding: 16px 18px; font-size: 0.95rem; line-height: 1.55; }

  .urovne { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); gap: 16px; }
  .urovne .card { padding: 22px; gap: 12px; }
  .urovne h3 { font-size: 1.1rem; }
  .urovne p { font-size: 0.9rem; }
  .meridlo { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; }
  .meridlo span { height: 6px; border-radius: 3px; background: var(--sky-light); }
  .meridlo span.plne { background: var(--accent); }
  .uroven { font-family: var(--fh); font-size: 0.8rem; font-weight: 700; color: var(--sky-ink); text-transform: uppercase; }

  .karty-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 22px; }
  .karty-2 h3 { font-size: 1.25rem; }

  .vyzva { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .btn--bila { background: var(--panel); }
</style>
