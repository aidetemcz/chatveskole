---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import PromptCard from '../components/PromptCard.astro';
import { url } from '../lib/url';
import { SKUPINY_PROMPTU, PORADI_KATEGORII, KATEGORIE_ZACI, promptText, pocet, slugify } from '../lib/data';

// Katalog promptů. Vysvětlení, co je prompt a jak ho psát, je na /funkce/prompty (content/stranky/funkce/prompty.md).
const TITULEK = 'Katalog promptů';
const POPIS = 'Ověřené prompty pro učitele, vedení škol i žáky. Zkopírujte prompt do jakéhokoli chatbota a doplňte údaje v hranatých závorkách.';
const vse = (await getCollection('prompty')).filter((p) => !p.id.startsWith('archiv-2024/'));

const polozka = (p: (typeof vse)[number]) => {
  const [skupina, slug] = p.id.split('/');
  return {
    id: p.id, skupina, title: p.data.title,
    kategorie: skupina === 'zaci' ? KATEGORIE_ZACI : (p.data.kategorie?.[0] ?? 'Ostatní'),
    href: skupina === 'zaci' ? `/funkce/prompty/zaci/${slug}` : `/funkce/prompty/${slug}`,
    text: promptText(p.body ?? ''),
    skill: !!p.data.skill,
  };
};
const items = vse.map(polozka).sort((a, b) => a.title.localeCompare(b.title, 'cs'));
const kategorie = [...new Set(items.map((i) => i.kategorie))].sort((a, b) => {
  const ia = PORADI_KATEGORII.indexOf(a), ib = PORADI_KATEGORII.indexOf(b);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.localeCompare(b, 'cs');
});
const views = [
  { id: 'ucel', groups: kategorie.map((k) => ({ id: slugify(k), title: k, items: items.filter((i) => i.kategorie === k) })) },
  { id: 'komu', groups: SKUPINY_PROMPTU.map((s) => ({ id: `pro-${s.id}`, title: s.title, items: items.filter((i) => i.skupina === s.id) })).filter((g) => g.items.length) },
];
---
<Base title={TITULEK} description={POPIS}>
  <div class="band band--white" style="padding-bottom: 32px">
    <div class="wrap stack" style="gap: 32px">
      <Crumbs items={[{ title: 'Prompty', href: '/funkce/prompty' }, { title: TITULEK }]} />
      <header class="page-head">
        <h1>{TITULEK}</h1>
        <p class="lede">{POPIS}</p>
      </header>
      <div class="seg" role="group" aria-label="Řazení" data-switch="skupiny-promptu" style="align-self: flex-start">
        <button type="button" data-target="ucel" aria-pressed="true">Řadit dle účelu</button>
        <button type="button" data-target="komu" aria-pressed="false">Řadit dle toho, komu slouží</button>
      </div>
    </div>
  </div>

  <div id="skupiny-promptu">
    {views.map((v) => (
      <div data-group-view={v.id} hidden={v.id !== 'ucel'} data-pagefind-ignore={v.id !== 'ucel' ? '' : undefined}>
        {v.groups.map((g, i) => (
          <section id={v.id === 'ucel' ? g.id : undefined} class={`band ${i % 2 === 0 ? 'band--sky' : 'band--white'}`} aria-label={g.title}>
            <div class="wrap stack" style="gap: 28px">
              <h2 style="font-size: 1.7rem">{g.title} <span class="count">{pocet(g.items.length, 'prompt', 'prompty', 'promptů')}</span></h2>
              <div class="grid-2">
                {g.items.map((p) => <PromptCard title={p.title} href={p.href} text={p.text} id={`${v.id}-${p.id.replace('/', '-')}`} skill={p.skill} />)}
              </div>
            </div>
          </section>
        ))}
      </div>
    ))}
  </div>

  <div class="band band--white">
    <div class="wrap">
      <p style="color: var(--muted)">Jak prompt napsat nebo upravit pro svou třídu, popisujeme na stránce <a href={url('/funkce/prompty')}>Prompty</a>.</p>
    </div>
  </div>
</Base>
