---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroKrajina from '../components/HeroKrajina.astro';
import { url } from '../lib/url';
import { sady, skills, pocet } from '../lib/data';

const prompty = await getCollection('prompty');
const nSkup = (s: string) => prompty.filter((p) => p.id.startsWith(s + '/')).length;
const nUcitele = nSkup('pedagogove');
const nVedeni = nSkup('vedeni');
const nZaci = nSkup('zaci');
const nKatalog = nUcitele + nVedeni + nZaci;
---
<Base title="Chatboti ve škole" description="Jak využívat chatboty ve škole: skills a prompty pro učitele a vedení škol, aktuální přehled funkcí, cen a věkových limitů, metodiky a doporučení.">

  <section class="hero" aria-label="Úvod">
    <HeroKrajina />
    <div class="wrap hero-in">
      <div class="page-head hero-text">
        <h1>Chatboti <em>ve škole</em></h1>
        <p class="lede">Web Chatboti ve škole je komplexním rozcestníkem pro začátečníky i pokročilé. Najdete zde aktuální přehledy funkcí, jejich vysvětlení, instruktážní videa, kvalitní prompty, skilly i pluginy ke stažení. V sekci Chatboti ve výuce nabízíme pedagogické metody, jak uchopit výuku s chatboty tak, aby podporovala rozvoj žáků.</p>
        <div class="hero-btns">
          <a class="btn btn--primary" href={url('/skills')}>Katalog skills</a>
          <a class="btn btn--outline" href={url('/prompty')}>Katalog promptů</a>
        </div>
      </div>
      <a class="sticker" href={url('/funkce/zmeny-2026')}>
        <span>Změny ve<br />funkcích chatbotů<br />v roce 2026</span>
      </a>
    </div>
  </section>

  <section class="band band--hp band--white" aria-labelledby="skills-h">
    <div class="wrap stack" style="gap: 30px">
      <div class="section-head">
        <div><h2 id="skills-h">Skills (dovednosti)</h2><p style="max-width: none">Skills nahrazují v ChatGPT i Gemini AI asistenty a mohou zároveň sloužit také jako samotné prompty.<br />Připravili jsme pro vás několik sad, které dělíme do následujících kategorií:</p></div>
        <a class="more" href={url('/skills')}>Katalog skills →</a>
      </div>
      <div class="grid-cards">
        {sady.map((s) => (
          <a class="card card--lg" href={url(`/sady/${s.slug}`)}>
            <div class="card-top"><h3 style="font-size: 1.2rem">{s.title}</h3><span class="count" style="font-size: 0.78rem">{pocet(s.skills.length, 'skill', 'skills', 'skills')}</span></div>
            <p>{s.popis}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--hp band--sky" aria-labelledby="prompty-h">
    <div class="wrap stack" style="gap: 30px">
      <div class="section-head">
        <div><h2 id="prompty-h">Katalog promptů</h2><p>Ověřené prompty pro učitele, vedení škol i žáky. Stačí zkopírovat do chatbota a doplnit údaje.</p></div>
        <a class="more" href={url('/prompty')}>Všech {nKatalog} promptů →</a>
      </div>
      <div class="grid-3">
        <a class="card card--lg" href={url('/prompty')}>
          <div class="card-top"><span class="title-row"><span class="tile-icon tile-icon--accent"><Icon name="chat" size={18} /></span><h3 style="font-size: 1.15rem">Pro učitele</h3></span><span class="count" style="font-size: 0.78rem">{pocet(nUcitele, 'prompt', 'prompty', 'promptů')}</span></div>
          <p>Formativní a slovní hodnocení, pracovní listy, úpravy materiálů a komunikace s rodiči.</p>
        </a>
        <a class="card card--lg" href={url('/prompty')}>
          <div class="card-top"><span class="title-row"><span class="tile-icon tile-icon--accent"><Icon name="school" size={18} /></span><h3 style="font-size: 1.15rem">Pro vedení školy</h3></span><span class="count" style="font-size: 0.78rem">{pocet(nVedeni, 'prompt', 'prompty', 'promptů')}</span></div>
          <p>Strategie školy, hodnoty, mise a vize, profil absolventa, školní pravidla a hodnocení kvality výuky.</p>
        </a>
        <a class="card card--lg" href={url('/funkce/prompty/zaci')}>
          <div class="card-top"><span class="title-row"><span class="tile-icon tile-icon--sky"><Icon name="cap" size={18} /></span><h3 style="font-size: 1.15rem">Pro žáky</h3></span><span class="count" style="font-size: 0.78rem">{pocet(nZaci, 'prompt', 'prompty', 'promptů')}</span></div>
          <p>Argumentace, brainstorming, plánování nebo zpětná vazba — způsoby využití generativní AI ve výuce vytvořené s NPI ČR.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="band band--hp band--white" aria-labelledby="vyuka-h">
    <div class="wrap stack" style="gap: 32px">
      <div class="section-head">
        <div><h2 id="vyuka-h">Chatboti ve výuce</h2><p>Jak s chatboty pracovat ve třídě, aby se žáci učili víc, ne míň: bezpečná aplikace pro žáky, metodiky s hotovými lekcemi a doporučení, ze kterých může škola vycházet.</p></div>
      </div>
      <a href="https://tiny.school" class="tiny-banner"><img src={url('/img/banner-tiny.png')} alt="AI aplikace Tiny pro školy zdarma. Chatboti do výuky bezpečně a didakticky správně. tiny.school" width="681" height="166" /></a>
      <div class="grid-3">
        <div class="card card--lg">
          <h3 style="font-size: 1.15rem">Aplikace Tiny</h3>
          <p>Velké chatboty nejsou dělané pro děti. V Tiny žáci pracují bez vlastních účtů u velkých firem a učitel vidí jejich konverzace v reálném čase.</p>
          <ul class="ticks"><li>11 chatbotů pro žáky podle Bloomovy taxonomie</li><li>aktivity bez AI</li><li>AI asistenti pro učitele</li></ul>
          <a class="more" href={url('/ve-vyuce/tiny')} style="margin-top: auto">O aplikaci Tiny →</a>
        </div>
        <div class="card card--lg">
          <h3 style="font-size: 1.15rem">Metodiky k chatbotům</h3>
          <a class="li" href="https://kurikulum.aidetem.cz/knowledgebase/chatboti-ve-vyuce-pracovni-listy/">Chatboti ve výuce — pracovní listy</a>
          <a class="li" href="https://kurikulum.aidetem.cz/knowledgebase/zpusoby-vyuziti-chatbotu-ve-vyuce/">Způsoby využití chatbotů ve výuce</a>
          <a class="li" href="https://kurikulum.aidetem.cz/knowledgebase/rozvoj-mysleni-s-vyuzitim-chatbota/">Rozvoj myšlení s využitím chatbota</a>
          <a class="li" href="https://kurikulum.aidetem.cz/knowledgebase/data-02-vizualizace-dat-casova-rada/">Data 02 — Interpretace dat pomocí chatbotů</a>
          <a class="more" href={url('/ve-vyuce/metodiky')} style="margin-top: auto">Všechny metodiky →</a>
        </div>
        <div class="card card--lg">
          <h3 style="font-size: 1.15rem">Doporučení pro využívání AI</h3>
          <a class="li2" href={url('/ve-vyuce/doporuceni-zs-ss')}><strong>Doporučení pro ZŠ a SŠ</strong><span>Jak na AI ve škole — Národní pedagogický institut ČR</span></a>
          <a class="li2" href={url('/ve-vyuce/doporuceni-vs')}><strong>Doporučení pro VŠ</strong><span>Pracovní skupina prg.ai a Univerzity Karlovy</span></a>
        </div>
      </div>
      <div class="card card--lg rules">
        <div class="stack" style="gap: 10px; flex: 1 1 520px">
          <h3 style="font-size: 1.35rem">Tvorba školních pravidel pro využívání AI ve výuce</h3>
          <p>Žáci AI používají, ať to škola dovolí, nebo ne. Pravidla nejsou o zákazu, ale o tom, kdy a jak AI učení pomáhá a kdy ho nahrazuje — a aby všichni věděli, co platí.</p>
        </div>
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px">
          <a class="btn btn--outline" href={url('/ve-vyuce/pravidla-pro-ai')}>Jak na pravidla</a>
          <a class="more" href={url('/skills/skolni-pravidla')}>Skill Školní pravidla →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--hp band--sky" aria-label="Pluginy a vibe coding">
    <div class="wrap" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 22px">
      <a class="card card--lg big" href={url('/funkce/pluginy')}>
        <span class="tile-icon tile-icon--accent" style="width: 44px; height: 44px"><Icon name="box" size={22} /></span>
        <h2>Pluginy</h2>
        <p>Celou sadu skills nainstalujete najednou. Pluginy podle našich sad máme pro Claude a ChatGPT.</p>
        <span class="more" style="margin-top: auto">Co jsou pluginy →</span>
      </a>
      <a class="card card--lg big" href={url('/vibe-coding/co-je-to')}>
        <span class="tile-icon tile-icon--sky" style="width: 44px; height: 44px"><Icon name="code" size={22} /></span>
        <h2>Vibe coding</h2>
        <p>Webová stránka, kvíz nebo malá aplikace do hodiny bez znalosti programování. Stačí popsat, co chcete, a chatbot to postaví.</p>
        <span class="more" style="margin-top: auto">Co je vibe coding →</span>
      </a>
    </div>
  </section>

  <section class="band band--hp band--white" aria-labelledby="metodiky-h">
    <div class="wrap stack" style="gap: 30px">
      <div class="section-head">
        <h2 id="metodiky-h">Metodické materiály</h2>
        <a class="more" href={url('/ve-vyuce/metodiky')}>Všechny metodické materiály →</a>
      </div>
      <div class="grid-4">
        <a class="thumb" href="https://kurikulum.aidetem.cz/knowledgebase/chatboti-ve-vyuce-pracovni-listy/"><img src={url('/img/metodika-chatboti-ve-vyuce.png')} alt="" loading="lazy" /><div><h3>Chatboti ve výuce</h3><p>Úvod do promptování pro žáky od 13 let.</p></div></a>
        <a class="thumb" href="https://kurikulum.aidetem.cz/"><img src={url('/img/metodika-formativni-hodnoceni.jpg')} alt="" loading="lazy" /><div><h3>Využití chatbotů ve formativním hodnocení</h3><p>Metodika k sadě skills Formativní hodnocení.</p></div></a>
        <a class="thumb" href="https://kurikulum.aidetem.cz/knowledgebase/rozvoj-mysleni-s-vyuzitim-chatbota/"><img src={url('/img/metodika-rozvoj-mysleni.png')} alt="" loading="lazy" /><div><h3>Rozvoj myšlení s využitím chatbota</h3><p>Žáci rozvíjejí myšlení prostřednictvím otázek.</p></div></a>
        <a class="thumb" href="https://www.tiny.school/metodiky/"><img src={url('/img/metodika-tiny.jpg')} alt="" loading="lazy" /><div><h3>Metodiky k aplikaci Tiny</h3><p>Podpůrné materiály pro využívání aplikace Tiny ve výuce.</p></div></a>
      </div>
    </div>
  </section>

  <section class="band band--hp band--sky" aria-label="Kniha a novinky">
    <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 22px">
      <div class="card card--lg book">
        <img src={url('/img/kniha-ai-ve-skole-prakticky.jpg')} alt="Obálka knihy AI ve škole prakticky" loading="lazy" />
        <div class="stack" style="gap: 14px; flex: 1 1 240px">
          <h2 style="font-size: 1.35rem">Kniha AI ve škole prakticky</h2>
          <p>Srozumitelný průvodce generativní umělou inteligencí pro všechny, kdo se věnují vzdělávání — od základních škol po univerzity.</p>
          <a class="more" href="https://vzdelavame.aidetem.cz/akce/publikace/ai-ve-skole-prakticky/">Objednat knihu →</a>
        </div>
      </div>
      <div class="newsletter">
        <h2 style="font-size: 1.25rem">Novinky do e-mailu</h2>
        <p>Funkce chatbotů se mění každý měsíc. Pošleme vám, co je pro školy důležité.</p>
        <!-- Odběr přes veřejný formulář Ecomailu (žádný skript ani cookies na našem webu). -->
        <div><a class="btn btn--primary" href="https://aidetem.ecomailapp.cz/public/form/2-2bb287d15897fe2f9d89c882af9a3a8b">Přihlásit se k odběru</a></div>
      </div>
    </div>
  </section>

</Base>

<style>
  /* hero: animovaná krajina (HeroKrajina) pod textem; nebe nahoře, země dole má výšku --zeme */
  .hero { position: relative; --zeme: 240px; background: var(--sky-light); padding: 104px 0 calc(var(--zeme) + 64px); }
  .hero-in { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 40px 56px; pointer-events: none; }
  .hero-in > * { pointer-events: auto; }
  .hero-text { flex: 1 1 520px; }
  .hero h1 { font-size: clamp(2.2rem, 4.6vw, 3.4rem); max-width: 14ch; color: var(--accent); }
  .hero h1 em { color: var(--accent); }
  .hero .lede { font-size: 1.15rem; max-width: 56ch; color: #1f3f4d; }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 16px; padding-top: 12px; }
  .hero .btn--primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .hero .btn--primary:hover { background: #c24848; border-color: #c24848; color: #fff; filter: none; }
  .hero .btn--outline { background: rgba(255, 255, 255, 0.6); border-color: var(--accent); color: var(--accent); }
  .hero .btn--outline:hover { background: #fff; color: #c24848; }

  .sticker { flex: none; width: 189px; height: 189px; border-radius: 50%; background: #fff; color: var(--accent-ink); display: flex; align-items: center; justify-content: center; padding: 40px 6px; text-align: center; text-decoration: none; font-family: var(--fb); font-weight: 400; font-size: 1.15rem; line-height: 1.3; white-space: nowrap; transform: rotate(8deg); transition: transform 0.2s ease; box-shadow: 0 8px 24px rgba(31, 63, 77, 0.12); margin-right: 12px; }
  .sticker:hover { color: var(--accent-ink); transform: rotate(3deg) scale(1.04); }
  @media (max-width: 640px) {
    .hero { --zeme: 190px; padding-top: 72px; padding-bottom: calc(var(--zeme) + 48px); }
    .sticker { margin-left: auto; }
  }
  .title-row { display: flex; align-items: center; gap: 10px; }
  .title-row .tile-icon { width: 34px; height: 34px; border-radius: 5px; }
  .tiny-banner { display: block; border-radius: var(--radius-lg); overflow: hidden; }
  .tiny-banner img { display: block; width: 100%; height: auto; }
  .li { text-decoration: none; font-weight: 500; }
  .li2 { text-decoration: none; display: flex; flex-direction: column; }
  .li2 strong { font-weight: 600; }
  .li2 span { font-size: 0.88rem; color: var(--muted); }
  .ticks { margin: 0; padding-left: 18px; font-size: 0.93rem; display: flex; flex-direction: column; gap: 7px; }
  .rules { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px; padding: 34px 36px; }
  .big h2 { font-size: 1.5rem; }
  .big p { font-size: 1rem; }
  .grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  @media (max-width: 1000px) { .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .grid-4 { grid-template-columns: minmax(0, 1fr); } }
  .thumb { border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; text-decoration: none; color: var(--ink); display: flex; flex-direction: column; background: var(--panel); }
  .thumb img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .thumb div { padding: 24px 26px; display: flex; flex-direction: column; gap: 10px; }
  .thumb h3 { font-size: 1.05rem; font-weight: 700; }
  .thumb p { color: var(--muted); font-size: 0.9rem; }
  .book { flex: 2 1 560px; flex-direction: row; flex-wrap: wrap; gap: 36px; align-items: center; padding: 34px 36px; }
  .book img { width: 240px; max-width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 8px; display: block; flex: none; }
  .newsletter { flex: 1 1 300px; background: var(--panel); border: 1px solid var(--sky); border-radius: var(--radius-lg); padding: 34px 36px; display: flex; flex-direction: column; gap: 16px; justify-content: center; }
  .newsletter p { color: var(--muted); font-size: 0.93rem; }
</style>
