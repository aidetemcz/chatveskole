---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Komponenta from '../components/Komponenta.astro';
import OdkazyKonec from '../components/OdkazyKonec.astro';
import { rozdel } from '../lib/komponenty';
import { navigace } from '../lib/data';
import { url } from '../lib/url';

export async function getStaticPaths() {
  const stranky = await getCollection('stranky');
  // vlastní šablony: index = hlavní stránka, zmeny-funkci = funkce/zmeny-2026
  return stranky
    .filter((s) => s.id !== 'index' && s.data.sablona !== 'zmeny-funkci')
    .map((s) => ({ params: { slug: s.id }, props: { stranka: s } }));
}

const { stranka } = Astro.props;
const casti = rozdel(stranka.rendered?.html ?? '');
const href = '/' + stranka.id;
const skupina = navigace.menu.find((g) => g.items.some((i) => i.href === href));
const d = stranka.data;
const datum = d.aktualizovano ? d.aktualizovano.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'numeric', year: 'numeric' }) : null;
// tlačítko na konci stránky (frontmatter: tlacitko: { text, href }), např. „Přejít na Katalog promptů“
const tlacitko = d.tlacitko && typeof d.tlacitko === 'object' && d.tlacitko.href ? (d.tlacitko as { text: string; href: string }) : null;
// odkazy na konci stránky jako tlačítka: frontmatter tlacitko + odkazy: [{ text, href }] + poslední odstavec, který obsahuje jen interní odkazy
type Odkaz = { text: string; href: string };
const zFm: Odkaz[] = [tlacitko, ...(Array.isArray(d.odkazy) ? d.odkazy : [])].filter((o): o is Odkaz => !!o && !!o.href).map((o) => ({ text: o.text, href: url(o.href) }));
const posledni = casti[casti.length - 1];
let zTextu: Odkaz[] = [];
if (posledni && posledni.typ === 'html') {
  const m = posledni.html.match(/<p>((?:\s*<a [^>]*>[^<]*<\/a>\s*[·|]?)+)\s*<\/p>\s*$/);
  if (m) {
    const odk = [...m[1].matchAll(/<a [^>]*href="([^"]+)"[^>]*>([^<]*)<\/a>/g)].map(([, h, t]) => ({ href: h, text: t.trim() }));
    if (odk.length && odk.every((o) => o.href.startsWith('/'))) { zTextu = odk; posledni.html = posledni.html.slice(0, m.index); }
  }
}
const odkazy = [...zFm, ...zTextu.filter((o) => !zFm.some((f) => f.href === o.href))];
---
<Base title={d.title} description={d.popis}>
  <div class="wrap layout">
    <article class="content">
      <Crumbs items={skupina ? [{ title: skupina.title }, { title: d.menu_titulek ?? d.title }] : [{ title: d.title }]} />
      <header class="page-head">
        {datum && <span class="draft">Aktualizováno {datum}</span>}
        <h1>{d.title}</h1>
      </header>
      {casti.map((c, i) => c.typ === 'html'
        ? <div class:list={['prose', { 'prose--dalsi': i > 0 }]} set:html={c.html} />
        : <Komponenta klic={c.klic} />)}
      <OdkazyKonec odkazy={odkazy} />
    </article>
  </div>
</Base>

<style>
  .layout { padding-top: 52px; padding-bottom: 84px; } /* stejně jako pruhy, viz docs/design.md */
  .content { min-width: 0; display: flex; flex-direction: column; gap: 32px; container-type: inline-size; }
  /* tabulky přes celou šířku obsahu (1140 px), ne jen sloupce textu (72 znaků) */
  @media (min-width: 861px) {
    .content :global(.prose > table) { display: table; width: 100cqi; border-collapse: separate; border-spacing: 0; overflow: hidden; }
    .content :global(.prose > .nahledy), .content :global(.prose > .karta-obrazek) { width: 100cqi; max-width: none; }
  }
  .page-head { align-items: flex-start; }
  .tlacitko-konec { padding: 0 0 8px; } /* od textu 32px (gap .content) */
</style>
