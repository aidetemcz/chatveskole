---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { navigace, INTERNI_ZDROJE } from '../lib/data';
import { url } from '../lib/url';

export async function getStaticPaths() {
  const stranky = await getCollection('stranky');
  // index = hlavní stránka, funkce/prompty = katalog promptů (vlastní šablony)
  return stranky
    .filter((s) => s.id !== 'index' && s.id !== 'funkce/prompty')
    .map((s) => ({ params: { slug: s.id }, props: { stranka: s } }));
}

const { stranka } = Astro.props;
const { Content } = await render(stranka);
const href = '/' + stranka.id;
const skupina = navigace.menu.find((g) => g.items.some((i) => i.href === href));
const d = stranka.data;
const datum = d.aktualizovano ? d.aktualizovano.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'numeric', year: 'numeric' }) : null;
const zdroje: string[] = Array.isArray(d.zdroje) ? d.zdroje.filter((z: unknown) => typeof z === 'string') : [];
const koncept = d.stav === 'koncept' || d.stav === 'ke-kontrole';
---
<Base title={d.title} description={d.popis}>
  <div class="wrap layout">
    {skupina && (
      <nav class="side" aria-label={`Sekce ${skupina.title}`}>
        <span class="side-title">{skupina.title}</span>
        {skupina.items.map((it) => (
          <a href={url(it.href)} aria-current={it.href === href ? 'page' : undefined}>{it.title}</a>
        ))}
      </nav>
    )}
    <article class="content">
      <Crumbs items={skupina ? [{ title: skupina.title }, { title: d.menu_titulek ?? d.title }] : [{ title: d.title }]} />
      <header class="page-head">
        {koncept && <span class="draft" title="Stránka čeká na kontrolu obsahu">Koncept</span>}
        <h1>{d.title}</h1>
      </header>
      <div class="prose">
        <Content />
      </div>
      {(zdroje.length > 0 || datum) && (
        <footer class="meta">
          {zdroje.length > 0 && (
            <details>
              <summary>Zdroje ({zdroje.length})</summary>
              <ul>{zdroje.map((z) => {
                const interni = INTERNI_ZDROJE[z];
                if (interni) return <li><a href={url(interni.href)}>{interni.title}</a></li>;
                if (/^https?:/.test(z)) return <li><a href={z}>{z.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></li>;
                return <li>{z}</li>;
              })}</ul>
            </details>
          )}
          {datum && <p>Aktualizováno {datum}</p>}
        </footer>
      )}
    </article>
  </div>
</Base>

<style>
  .layout { display: flex; flex-wrap: wrap; gap: 32px 56px; align-items: flex-start; padding-top: 36px; padding-bottom: 64px; }
  .side { flex: 1 1 220px; max-width: 260px; display: flex; flex-direction: column; gap: 2px; font-size: 0.92rem; }
  .side-title { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--sky-ink); font-weight: 600; padding: 0 12px 8px; }
  .side a { padding: 8px 12px; border-radius: 10px; color: var(--ink); text-decoration: none; }
  .side a:hover { background: var(--line-soft); }
  .side a[aria-current='page'] { background: var(--sky-light); font-weight: 600; }
  .content { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .page-head { align-items: flex-start; }
  .meta { border-top: 1px solid var(--line); padding-top: 18px; font-size: 0.85rem; color: var(--muted); display: flex; flex-direction: column; gap: 10px; max-width: 72ch; }
  .meta summary { cursor: pointer; font-weight: 600; color: var(--ink); }
  .meta ul { margin: 10px 0 0; padding-left: 18px; display: flex; flex-direction: column; gap: 4px; word-break: break-word; }
  @media (max-width: 860px) { .side { max-width: none; flex-direction: row; flex-wrap: wrap; } .side-title { width: 100%; } }
</style>
