---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Komponenta from '../components/Komponenta.astro';
import { rozdel } from '../lib/komponenty';
import { navigace, INTERNI_ZDROJE } from '../lib/data';
import { url } from '../lib/url';

export async function getStaticPaths() {
  const stranky = await getCollection('stranky');
  // vlastní šablony: index = hlavní stránka, zmeny-funkci = funkce/zmeny-2026
  return stranky
    .filter((s) => s.id !== 'index' && s.data.sablona !== 'zmeny-funkci')
    .map((s) => ({ params: { slug: s.id }, props: { stranka: s } }));
}

const { stranka } = Astro.props;
const casti = rozdel(stranka.rendered?.html ?? '');
const href = '/' + stranka.id;
const skupina = navigace.menu.find((g) => g.items.some((i) => i.href === href));
const d = stranka.data;
const datum = d.aktualizovano ? d.aktualizovano.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'numeric', year: 'numeric' }) : null;
const zdroje: string[] = Array.isArray(d.zdroje) ? d.zdroje.filter((z: unknown) => typeof z === 'string') : [];
const koncept = d.stav === 'koncept' || d.stav === 'ke-kontrole';
// tlačítko na konci stránky (frontmatter: tlacitko: { text, href }), např. „Přejít na Katalog promptů“
const tlacitko = d.tlacitko && typeof d.tlacitko === 'object' && d.tlacitko.href ? (d.tlacitko as { text: string; href: string }) : null;
---
<Base title={d.title} description={d.popis}>
  <div class="wrap layout">
    <article class="content">
      <Crumbs items={skupina ? [{ title: skupina.title }, { title: d.menu_titulek ?? d.title }] : [{ title: d.title }]} />
      <header class="page-head">
        {koncept && <span class="draft" title="Stránka čeká na kontrolu obsahu">Koncept</span>}
        <h1>{d.title}</h1>
      </header>
      {casti.map((c, i) => c.typ === 'html'
        ? <div class:list={['prose', { 'prose--dalsi': i > 0 }]} set:html={c.html} />
        : <Komponenta klic={c.klic} />)}
      {tlacitko && (
        <p class="tlacitko-konec"><a class="btn btn--primary" href={url(tlacitko.href)}>{tlacitko.text} →</a></p>
      )}
      {(zdroje.length > 0 || datum) && (
        <footer class="meta">
          {zdroje.length > 0 && (
            <details>
              <summary>Zdroje ({zdroje.length})</summary>
              <ul>{zdroje.map((z) => {
                const interni = INTERNI_ZDROJE[z];
                if (interni) return <li><a href={url(interni.href)}>{interni.title}</a></li>;
                if (/^https?:/.test(z)) return <li><a href={z}>{z.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></li>;
                return <li>{z}</li>;
              })}</ul>
            </details>
          )}
          {datum && <p>Aktualizováno {datum}</p>}
        </footer>
      )}
    </article>
  </div>
</Base>

<style>
  .layout { padding-top: 52px; padding-bottom: 96px; }
  .content { min-width: 0; display: flex; flex-direction: column; gap: 32px; }
  .page-head { align-items: flex-start; }
  .tlacitko-konec { padding: 0 0 8px; } /* od textu 32px (gap .content) */
  .meta { border-top: 1px solid var(--line); padding-top: 24px; font-size: 0.85rem; color: var(--muted); display: flex; flex-direction: column; gap: 10px; max-width: 72ch; }
  .meta summary { cursor: pointer; font-weight: 600; color: var(--ink); }
  .meta ul { margin: 10px 0 0; padding-left: 18px; display: flex; flex-direction: column; gap: 4px; word-break: break-word; }
</style>
