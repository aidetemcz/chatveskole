---
import { getCollection, render } from 'astro:content';
import Zaklad from '../layouts/Zaklad.astro';
import { zobrazit, jeKoncept, sekceProUrl } from '../lib/web';

export async function getStaticPaths() {
  const stranky = await getCollection('stranky', (s) => zobrazit(s.data.stav));
  return stranky.map((s) => ({
    params: { stranka: s.id === 'index' ? undefined : s.id },
    props: { stranka: s },
  }));
}

const { stranka } = Astro.props;
const { Content } = await render(stranka);
const sekce = sekceProUrl(`/${stranka.id}`);
// Zdroje typu „data/…yaml“ vykreslí datové šablony (fáze 4); tady jen odkazy.
const zdroje = (stranka.data.zdroje ?? []).filter((z) => /^https?:/.test(typeof z === 'string' ? z : z.url));
---
<Zaklad title={stranka.data.title} popis={stranka.data.popis} koncept={jeKoncept(stranka.data.stav)}>
  {sekce && <p class="eyebrow">{sekce}</p>}
  <Content />
  {zdroje.length > 0 && (
    <section aria-labelledby="zdroje">
      <h2 id="zdroje">Zdroje</h2>
      <ul>
        {zdroje.map((z) => {
          const url = typeof z === 'string' ? z : z.url;
          const nazev = typeof z === 'string' ? z : (z.nazev ?? z.url);
          return <li><a href={url}>{nazev}</a></li>;
        })}
      </ul>
    </section>
  )}
</Zaklad>
